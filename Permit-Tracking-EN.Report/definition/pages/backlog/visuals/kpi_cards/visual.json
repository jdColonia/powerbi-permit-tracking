            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\"$schema\":\"https://vega.github.io/schema/vega-lite/v5.json\",\"description\":\"KPI cards (one per row of KpiCards): value, variation, progress bar baseline -> target, baseline and target.\",\"data\":{\"name\":\"dataset\"},\"width\":1824,\"height\":224,\"autosize\":{\"type\":\"none\"},\"padding\":0,\"config\":{\"view\":{\"stroke\":null},\"text\":{\"font\":\"Segoe UI\"}},\"transform\":[{\"calculate\":\"(datum.Orden - 1) * 460\",\"as\":\"x0\"},{\"calculate\":\"datum.x0 + 444\",\"as\":\"x1\"},{\"calculate\":\"datum.x0 + 24\",\"as\":\"xa1\"},{\"calculate\":\"datum.x0 + 64\",\"as\":\"xa2\"},{\"calculate\":\"datum.x0 + 20\",\"as\":\"xl\"},{\"calculate\":\"datum.x1 - 20\",\"as\":\"xr\"},{\"calculate\":\"datum.xr - 58\",\"as\":\"xrango\"},{\"calculate\":\"datum.xl + 4 + length(datum.ValorTxt) * 23\",\"as\":\"xunidad\"},{\"calculate\":\"datum.xl + length(datum.VariacionTxt) * 6.4 + 24\",\"as\":\"xpill\"},{\"calculate\":\"(datum.xl + datum.xpill) / 2\",\"as\":\"xpillc\"},{\"calculate\":\"datum.xl + 404 * (isValid(datum.Avance) ? datum.Avance : 0)\",\"as\":\"xavance\"},{\"calculate\":\"datum.Cumplida == 1 ? ''#1A7F4B'' : ''#E5402B''\",\"as\":\"colorAvance\"},{\"calculate\":\"datum.Cumplida == 1 ? ''#E4E4E0'' : (datum.Variacion <= 0 ? ''#FDE3DE'' : ''#FDE3DE'')\",\"as\":\"fondoPill\"},{\"calculate\":\"datum.Cumplida == 1 ? ''#1A7F4B'' : (datum.Variacion <= 0 ? ''#2368B5'' : ''#C62828'')\",\"as\":\"textoPill\"}],\"layer\":[{\"mark\":{\"type\":\"rect\",\"fill\":\"#FFFFFF\",\"stroke\":\"#E4E4E0\",\"strokeWidth\":1},\"encoding\":{\"x\":{\"field\":\"x0\",\"type\":\"quantitative\",\"scale\":null},\"x2\":{\"field\":\"x1\"},\"y\":{\"value\":0.5},\"y2\":{\"value\":223.5}}},{\"mark\":{\"type\":\"rect\",\"fill\":\"#E5402B\"},\"encoding\":{\"x\":{\"field\":\"xa1\",\"type\":\"quantitative\",\"scale\":null},\"x2\":{\"field\":\"xa2\"},\"y\":{\"value\":18},\"y2\":{\"value\":23}}},{\"mark\":{\"type\":\"text\",\"baseline\":\"alphabetic\",\"align\":\"left\",\"fontSize\":18,\"fontWeight\":600,\"fill\":\"#0E1014\"},\"encoding\":{\"x\":{\"field\":\"xl\",\"type\":\"quantitative\",\"scale\":null},\"y\":{\"value\":48},\"text\":{\"field\":\"Titulo\"}}},{\"mark\":{\"type\":\"text\",\"baseline\":\"alphabetic\",\"align\":\"left\",\"fontSize\":12,\"fill\":\"#5F636A\"},\"encoding\":{\"x\":{\"field\":\"xl\",\"type\":\"quantitative\",\"scale\":null},\"y\":{\"value\":68},\"text\":{\"field\":\"Subtitulo\"}}},{\"mark\":{\"type\":\"text\",\"baseline\":\"alphabetic\",\"align\":\"left\",\"fontSize\":40,\"fontWeight\":\"bold\",\"fill\":\"#0E1014\"},\"encoding\":{\"x\":{\"field\":\"xl\",\"type\":\"quantitative\",\"scale\":null},\"y\":{\"value\":120},\"text\":{\"field\":\"ValorTxt\"}}},{\"mark\":{\"type\":\"text\",\"baseline\":\"alphabetic\",\"align\":\"left\",\"fontSize\":15,\"fill\":\"#5F636A\"},\"encoding\":{\"x\":{\"field\":\"xunidad\",\"type\":\"quantitative\",\"scale\":null},\"y\":{\"value\":118},\"text\":{\"field\":\"Unidad\"}}},{\"mark\":{\"type\":\"rect\",\"cornerRadius\":11},\"encoding\":{\"x\":{\"field\":\"xl\",\"type\":\"quantitative\",\"scale\":null},\"x2\":{\"field\":\"xpill\"},\"y\":{\"value\":132},\"y2\":{\"value\":154},\"fill\":{\"field\":\"fondoPill\",\"type\":\"nominal\",\"scale\":null}}},{\"mark\":{\"type\":\"text\",\"baseline\":\"alphabetic\",\"align\":\"center\",\"fontSize\":11.5},\"encoding\":{\"x\":{\"field\":\"xpillc\",\"type\":\"quantitative\",\"scale\":null},\"y\":{\"value\":147},\"text\":{\"field\":\"VariacionTxt\"},\"fill\":{\"field\":\"textoPill\",\"type\":\"nominal\",\"scale\":null}}},{\"mark\":{\"type\":\"rect\",\"fill\":\"#E4E4E0\"},\"encoding\":{\"x\":{\"field\":\"xl\",\"type\":\"quantitative\",\"scale\":null},\"x2\":{\"field\":\"xr\"},\"y\":{\"value\":164},\"y2\":{\"value\":170}}},{\"mark\":{\"type\":\"rect\"},\"encoding\":{\"x\":{\"field\":\"xl\",\"type\":\"quantitative\",\"scale\":null},\"x2\":{\"field\":\"xavance\"},\"y\":{\"value\":164},\"y2\":{\"value\":170},\"fill\":{\"field\":\"colorAvance\",\"type\":\"nominal\",\"scale\":null}}},{\"mark\":{\"type\":\"text\",\"baseline\":\"alphabetic\",\"align\":\"left\",\"fontSize\":11,\"fill\":\"#5F636A\"},\"encoding\":{\"x\":{\"field\":\"xl\",\"type\":\"quantitative\",\"scale\":null},\"y\":{\"value\":189},\"text\":{\"field\":\"RangoLB\"}}},{\"mark\":{\"type\":\"text\",\"baseline\":\"alphabetic\",\"align\":\"left\",\"fontSize\":16,\"fill\":\"#0E1014\"},\"encoding\":{\"x\":{\"field\":\"xl\",\"type\":\"quantitative\",\"scale\":null},\"y\":{\"value\":211},\"text\":{\"field\":\"LineaBaseTxt\"}}},{\"mark\":{\"type\":\"text\",\"baseline\":\"alphabetic\",\"align\":\"right\",\"fontSize\":11,\"fontWeight\":600,\"fill\":\"#5F636A\"},\"encoding\":{\"x\":{\"field\":\"xr\",\"type\":\"quantitative\",\"scale\":null},\"y\":{\"value\":189},\"text\":{\"value\":\"TARGET\"}}},{\"mark\":{\"type\":\"text\",\"baseline\":\"alphabetic\",\"align\":\"right\",\"fontSize\":16,\"fontWeight\":600,\"fill\":\"#1A7F4B\"},\"encoding\":{\"x\":{\"field\":\"xr\",\"type\":\"quantitative\",\"scale\":null},\"y\":{\"value\":211},\"text\":{\"field\":\"MetaTxt\"}}},{\"mark\":{\"type\":\"text\",\"baseline\":\"alphabetic\",\"align\":\"right\",\"fontSize\":11,\"fill\":\"#5F636A\"},\"encoding\":{\"x\":{\"field\":\"xrango\",\"type\":\"quantitative\",\"scale\":null},\"y\":{\"value\":210},\"text\":{\"field\":\"Rango\"}}}]}'"
