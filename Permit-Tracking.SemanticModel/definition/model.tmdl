model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

queryGroup '1. Parameters'

	annotation PBI_QueryGroupOrder = 1

queryGroup '2. Functions'

	annotation PBI_QueryGroupOrder = 2

queryGroup '3. Staging'

	annotation PBI_QueryGroupOrder = 3

queryGroup '4. Dimensions'

	annotation PBI_QueryGroupOrder = 4

queryGroup '5. Facts'

	annotation PBI_QueryGroupOrder = 5

queryGroup '6. Support'

	annotation PBI_QueryGroupOrder = 6

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["DataRoot", "OrderFiles", "fnReadFile", "fnReadCsv", "SnapshotDate", "fnText", "fnNumber", "fnInteger", "fnDate", "fnDateTime", "fnStripAccents", "fnKey", "fnClosureResult", "fnMunicipality", "OrdersSource", "ExpectedColumns", "OrdersRead", "OrdersUnique", "OrdersPermits", "ClosureReasonConfig", "OrderKm", "RequestsOutsideData", "Rates", "Dim_WorkType", "Dim_OrderStatus", "Dim_ClosureReason", "Dim_Location", "Dim_WorkUnit", "Fact_Orders", "Fact_Permits", "Dim_AgeBand", "Targets", "Settings", "KpiCards", "Dim_Calendar", "Info_Refresh", "Language", "_Measures"]

ref table Info_Refresh
ref table Language
ref table _Measures
ref table Fact_Orders
ref table Dim_WorkType
ref table Dim_OrderStatus
ref table Dim_ClosureReason
ref table Dim_Location
ref table Dim_WorkUnit
ref table Dim_Calendar
ref table Dim_AgeBand
ref table Targets
ref table Settings
ref table Fact_Permits
ref table KpiCards
ref table Rates
