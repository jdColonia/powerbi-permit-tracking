		lineageTag: 03418841-4b49-498b-9fa0-8b26d039c5ab

	/// Average granting days of the permits granted in the quarter; only quarters with 20 or more permits.
	measure 'Avg Granting By Quarter' =
			VAR cutoff = [Cutoff Date]
			VAR fromVal = DATE ( YEAR ( cutoff ) - 2, 1, 1 )
			VAR inRange = NOT ISBLANK ( cutoff ) && MAX ( Dim_Calendar[Date] ) >= fromVal && MIN ( Dim_Calendar[Date] ) <= cutoff
			VAR n = COUNTROWS ( Fact_Permits )
			RETURN IF ( inRange && n >= 20, AVERAGE ( Fact_Permits[Granting Days] ) )
		formatString: #,0
		displayFolder: 1. Backlog
		lineageTag: 66a073bc-3356-488a-8cf7-4b0a5510f19e

	/// 80th percentile of the granting days of the permits granted in the quarter; only quarters with 20 or more permits.
	measure 'P80 Granting By Quarter' =
			VAR cutoff = [Cutoff Date]
			VAR fromVal = DATE ( YEAR ( cutoff ) - 2, 1, 1 )
			VAR inRange = NOT ISBLANK ( cutoff ) && MAX ( Dim_Calendar[Date] ) >= fromVal && MIN ( Dim_Calendar[Date] ) <= cutoff
			VAR n = COUNTROWS ( Fact_Permits )
			RETURN IF ( inRange && n >= 20, PERCENTILE.INC ( Fact_Permits[Granting Days], 0.8 ) )
		formatString: #,0
		displayFolder: 1. Backlog
