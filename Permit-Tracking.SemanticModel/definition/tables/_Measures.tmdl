	/// Text of the target of Municipal formatted for the report language; blank if there is no value. The cards take it by the key of KpiCards.
	measure 'Target Text Municipal' =
			VAR v = [Target Municipal] RETURN IF ( NOT ISBLANK ( v ), FORMAT ( v, "#,0.0", [Locale] ) )
		displayFolder: 1. Backlog\Municipal KPI
		lineageTag: f844c0a8-68bb-48e2-b6fc-3340c6f55045

	/// Open backlog orders in the age band of the row (months since creation) at the cutoff date. Axis: Dim_AgeBand. Blank if no single band is in context.
	measure 'Backlog By Age' =
			VAR fromVal = SELECTEDVALUE ( Dim_AgeBand[From Days] )
			VAR toVal = SELECTEDVALUE ( Dim_AgeBand[To Days] )
			VAR t = [Cutoff Date]
			RETURN
			    IF (
			        HASONEVALUE ( Dim_AgeBand[Age Band Order] ),
			        COUNTROWS (
			            FILTER (
			                CALCULATETABLE (
			                    Fact_Orders,
			                    REMOVEFILTERS ( Dim_Calendar ),
			                    REMOVEFILTERS ( Dim_OrderStatus ),
			                    Dim_WorkType[Counts In Backlog] = TRUE (),
			                    Fact_Orders[In Backlog KPI] = TRUE (),
			                    NOT ISBLANK ( Fact_Orders[Created Date] ) && Fact_Orders[Created Date] <= t,
			                    ISBLANK ( Fact_Orders[Closure Date] ) || Fact_Orders[Closure Date] > t
			                ),
			                VAR d = DATEDIFF ( Fact_Orders[Created Date], t, DAY )
			                RETURN d >= fromVal && ( ISBLANK ( toVal ) || d < toVal )
			            )
			        )
			    )
		formatString: #,0
		displayFolder: 1. Backlog
		lineageTag: be326469-7d2e-4071-917f-8de48f181027

	/// Backlog orders open for [Age Alert Days] days or more at the cutoff date (same boundary as the 12 to 24 age band).
	measure 'Aged Backlog' =
			VAR t = [Cutoff Date]
			VAR threshold = [Age Alert Days]
			RETURN
			    COUNTROWS (
			        FILTER ( CALCULATETABLE (
			            Fact_Orders,
			            REMOVEFILTERS ( Dim_Calendar ),
			            REMOVEFILTERS ( Dim_OrderStatus ),
			            Dim_WorkType[Counts In Backlog] = TRUE (),
			            Fact_Orders[In Backlog KPI] = TRUE (),
			            NOT ISBLANK ( Fact_Orders[Created Date] ) && Fact_Orders[Created Date] <= t,
			            ISBLANK ( Fact_Orders[Closure Date] ) || Fact_Orders[Closure Date] > t
			        ), DATEDIFF ( Fact_Orders[Created Date], t, DAY ) >= threshold )
			    ) + 0
		formatString: #,0
		displayFolder: 1. Backlog
		lineageTag: 479f51fb-2429-41c3-b57e-ed68954781b2

	/// Subtitle of the age chart: how many orders are open and how many of them (and what share) have been open for more than the alert months. Bilingual.
	measure 'Age Subtitle' =
			VAR b = [KPI Backlog]
			VAR v = [Aged Backlog]
			RETURN
			    SWITCH (
			        [Lang],
			        "en", FORMAT ( b, "#,0", [Locale] ) & " open orders; " & FORMAT ( v, "#,0", [Locale] ) & " (" & FORMAT ( DIVIDE ( v, b ), "0%", [Locale] ) & ") have been open for more than " & [Age Alert Months] & " months",
			        FORMAT ( b, "#,0", [Locale] ) & " órdenes abiertas; " & FORMAT ( v, "#,0", [Locale] ) & " (" & FORMAT ( DIVIDE ( v, b ), "0 %", [Locale] ) & ") llevan más de " & [Age Alert Months] & " meses"
			    )
		displayFolder: 1. Backlog
		lineageTag: cddf104b-b3af-4c1b-9939-da991573e7e3

	/// Label of the aged zone of the age chart: "Over N months: x". Bilingual.
	measure 'Aged Zone Label' =
			SWITCH (
			    [Lang],
			    "en", "Over " & [Age Alert Months] & " months: " & FORMAT ( [Aged Backlog], "#,0", [Locale] ),
			    "Más de " & [Age Alert Months] & " meses: " & FORMAT ( [Aged Backlog], "#,0", [Locale] )
			)
		displayFolder: 1. Backlog
		lineageTag: 607a7ec0-482d-4e0d-815a-503fd6ead09b

	/// Open backlog of the municipality, shown only for the top 10 (ranked by [KPI Backlog] within the selected municipalities).
	measure 'Backlog Top Municipalities' =
			VAR v = [KPI Backlog]
			VAR r = RANKX ( ALLSELECTED ( Dim_Location[Municipality] ), [KPI Backlog], , DESC, SKIP )
			RETURN IF ( v > 0 && r <= 10, v )
		formatString: #,0
		displayFolder: 1. Backlog
		lineageTag: f3cf6cea-293f-4b5c-9231-81a37dec54b5

	/// Hidden. Fixed colour of the bars of the standalone permits chart.
	measure 'Color Standalone' =
			"#5F636A"
		isHidden
		displayFolder: 1. Backlog
		lineageTag: b61d7914-882b-47e1-8d4e-5a5dff85e0c3

	/// Open standalone orders created less than 2 years (730 days) before the cutoff date, by work type (entity). Blank for other groups.
	measure 'Standalone Up To 2 Years' =
			VAR t = [Cutoff Date]
			RETURN
			    IF (
			        SELECTEDVALUE ( Dim_WorkType[Group Key] ) = "Standalone",
			        COUNTROWS ( FILTER ( CALCULATETABLE (
			            Fact_Orders,
			            REMOVEFILTERS ( Dim_Calendar ),
			            REMOVEFILTERS ( Dim_OrderStatus ),
			            Dim_WorkType[Counts In Backlog] = TRUE (),
			            Fact_Orders[In Backlog KPI] = TRUE (),
			            NOT ISBLANK ( Fact_Orders[Created Date] ) && Fact_Orders[Created Date] <= t,
			            ISBLANK ( Fact_Orders[Closure Date] ) || Fact_Orders[Closure Date] > t
			        ), DATEDIFF ( Fact_Orders[Created Date], t, DAY ) < 730 ) )
			    )
		formatString: #,0
		displayFolder: 1. Backlog
		lineageTag: 651b1a3b-b93a-400a-9ffa-cf296d16e970

	/// Open standalone orders created 2 years (730 days) or more before the cutoff date, by work type (entity). Blank for other groups. Shown in red.
	measure 'Standalone Over 2 Years' =
			VAR t = [Cutoff Date]
			RETURN
			    IF (
			        SELECTEDVALUE ( Dim_WorkType[Group Key] ) = "Standalone",
			        COUNTROWS ( FILTER ( CALCULATETABLE (
			            Fact_Orders,
			            REMOVEFILTERS ( Dim_Calendar ),
			            REMOVEFILTERS ( Dim_OrderStatus ),
			            Dim_WorkType[Counts In Backlog] = TRUE (),
			            Fact_Orders[In Backlog KPI] = TRUE (),
			            NOT ISBLANK ( Fact_Orders[Created Date] ) && Fact_Orders[Created Date] <= t,
			            ISBLANK ( Fact_Orders[Closure Date] ) || Fact_Orders[Closure Date] > t
			        ), DATEDIFF ( Fact_Orders[Created Date], t, DAY ) >= 730 ) )
			    )
		formatString: #,0
		displayFolder: 1. Backlog
		lineageTag: 24d60340-1ad6-461f-9130-81a50db93ac6

	/// Average calendar days from creation to closure of the standalone orders closed with result Granted.
	measure 'Days To Permit Standalone' =
			AVERAGEX (
			    CALCULATETABLE (
			        Fact_Orders,
			        REMOVEFILTERS ( Dim_Calendar ),
			        REMOVEFILTERS ( Dim_OrderStatus ),
			        Dim_WorkType[Group Key] = "Standalone",
			        Dim_ClosureReason[Result Key] = "Granted"
			    ),
			    DATEDIFF ( Fact_Orders[Created Date], Fact_Orders[Closure Date], DAY )
			)
		formatString: #,0
		displayFolder: 1. Backlog
		lineageTag: ebd46bae-681d-4f3b-a2ed-6847505ec645

	/// Number of permits granted in the last N months (Time Window Months) up to the cutoff date. Does not use the page date filter.
	measure 'Permits Granted In Window' =
			VAR t = [Cutoff Date]
			VAR windowStart = EDATE ( t, - [Time Window Months] )
			RETURN
			    COUNTROWS ( CALCULATETABLE (
			            Fact_Permits,
			            REMOVEFILTERS ( Dim_Calendar ),
			            Fact_Permits[Granted Date] > windowStart,
			            Fact_Permits[Granted Date] <= t
			        ) ) + 0
		formatString: #,0
		displayFolder: 1. Backlog
		lineageTag: a7b8c0f6-f550-449c-a948-33e7efbe81eb

	/// 80th percentile of the granting days of the permits granted in the window: 8 out of 10 permits take less than this many days.
	measure 'P80 Granting' =
			VAR t = [Cutoff Date]
			VAR windowStart = EDATE ( t, - [Time Window Months] )
			RETURN
			    PERCENTILEX.INC ( CALCULATETABLE (
			            Fact_Permits,
			            REMOVEFILTERS ( Dim_Calendar ),
			            Fact_Permits[Granted Date] > windowStart,
			            Fact_Permits[Granted Date] <= t
			        ), Fact_Permits[Granting Days], 0.8 )
		formatString: #,0
		displayFolder: 1. Backlog
		lineageTag: 63779fc1-c097-46aa-a8d8-7bb7bb188328

	/// Average days of the filing stage (filing created -> documents filed) of the permits granted in the window.
	measure 'Avg Filing Stage Days' =
			VAR t = [Cutoff Date]
			VAR windowStart = EDATE ( t, - [Time Window Months] )
			RETURN
			    AVERAGEX ( CALCULATETABLE (
			            Fact_Permits,
			            REMOVEFILTERS ( Dim_Calendar ),
			            Fact_Permits[Granted Date] > windowStart,
			            Fact_Permits[Granted Date] <= t
			        ), Fact_Permits[Filing Days] )
		formatString: #,0
		displayFolder: 1. Backlog
		lineageTag: adb31eb3-5911-4639-a2b9-1245394129da

	/// Average days of the review stage (review created -> permit delivered) of the permits granted in the window.
	measure 'Avg Review Stage Days' =
			VAR t = [Cutoff Date]
			VAR windowStart = EDATE ( t, - [Time Window Months] )
			RETURN
			    AVERAGEX ( CALCULATETABLE (
			            Fact_Permits,
			            REMOVEFILTERS ( Dim_Calendar ),
			            Fact_Permits[Granted Date] > windowStart,
			            Fact_Permits[Granted Date] <= t
			        ), Fact_Permits[Review Days] )
		formatString: #,0
		displayFolder: 1. Backlog
		lineageTag: 05673fe3-bd2b-40e7-b204-43754810a71e

	/// Hidden. Sum of the average days of both stages; it is the total of the stacked bar of the cycle panel.
	measure 'Stage Days Total' =
			[Avg Filing Stage Days] + [Avg Review Stage Days]
		formatString: #,0
		isHidden
		displayFolder: 1. Backlog
		lineageTag: 89b64671-f468-4353-9df4-5c22a8b35706

	/// Text of the average granting time ("N days"): filing + review stages, the same split the stage bar shows. Bilingual.
	measure 'Granting Text' =
			VAR v = [Stage Days Total]
			RETURN IF ( NOT ISBLANK ( v ), FORMAT ( v, "#,0", [Locale] ) & SWITCH ( [Lang], "en", " days", " días" ) )
		displayFolder: 1. Backlog
		lineageTag: 79108d2d-e8df-4ff8-917b-b115aef7bd63

	/// Text of the 80th percentile granting time ("80% approved within N days"). Bilingual.
	measure 'P80 Granting Text' =
			VAR v = [P80 Granting]
			RETURN
			    IF (
			        NOT ISBLANK ( v ),
			        SWITCH ( [Lang], "en", "80% approved within " & FORMAT ( v, "#,0", [Locale] ) & " days", "8 de cada 10 se aprueban en menos de " & FORMAT ( v, "#,0", [Locale] ) & " días" )
			    )
		displayFolder: 1. Backlog
		lineageTag: 7e43cc63-7d07-4570-82ad-7a996a51982c

	/// Subtitle of the cycle panel: permits granted in the last N months. Bilingual.
	measure 'Cycle Subtitle' =
			SWITCH (
			    [Lang],
			    "en", "Permits granted in the last " & [Time Window Months] & " months: " & FORMAT ( [Permits Granted In Window], "#,0", [Locale] ),
			    "Permisos aprobados en los últimos " & [Time Window Months] & " meses: " & FORMAT ( [Permits Granted In Window], "#,0", [Locale] )
			)
		displayFolder: 1. Backlog
		lineageTag: 580b722b-b57f-433e-82da-01cbdf6001c5

	/// Hidden. Review orders closed in the last 12 months up to the cutoff date. Base of the outcome chart and of [Grant Rate].
	measure 'Reviews Closed 12 Months' =
			VAR t = [Cutoff Date]
			VAR windowStart = EDATE ( t, -12 )
			RETURN
			    CALCULATE (
			        COUNTROWS ( Fact_Orders ),
			        REMOVEFILTERS ( Dim_Calendar ),
			        REMOVEFILTERS ( Dim_OrderStatus ),
			        Dim_WorkType[Group Key] = "Review",
			        Fact_Orders[Closure Date] > windowStart,
			        Fact_Orders[Closure Date] <= t
			    ) + 0
		formatString: #,0
		isHidden
		displayFolder: 1. Backlog
		lineageTag: 4d287edb-b109-4aa5-bbb4-d51c20ed3e2f

	/// Reviews closed in the last 12 months by result (Granted, Denied, No response, Administrative closure). Axis: closure result.
	measure 'Review Outcomes' =
			IF ( SELECTEDVALUE ( Dim_ClosureReason[Result Key] ) IN { "Granted", "Denied", "NoResponse", "AdminClosure" }, [Reviews Closed 12 Months] )
		formatString: #,0
		displayFolder: 1. Backlog
		lineageTag: 1985e44c-05ec-4d22-b5da-ba1c7f8ba56a

	/// Hidden. Colour of each result bar: green granted, red denied, yellow no response, grey otherwise.
	measure 'Color Result' =
			SWITCH ( SELECTEDVALUE ( Dim_ClosureReason[Result Key] ), "Granted", "#1A7F4B", "Denied", "#C62828", "NoResponse", "#E3B341", "#B4BCC4" )
		isHidden
		displayFolder: 1. Backlog
		lineageTag: 2b7e994d-fbe4-4355-81b5-695625986c6d

	/// Share of reviews granted among those that ended with a decision or no answer: granted / (granted + denied + no response), last 12 months.
	measure 'Grant Rate' =
			VAR o = CALCULATE ( [Reviews Closed 12 Months], Dim_ClosureReason[Result Key] = "Granted" )
			VAR notGranted = CALCULATE ( [Reviews Closed 12 Months], Dim_ClosureReason[Result Key] IN { "Denied", "NoResponse" } )
			RETURN DIVIDE ( o, o + notGranted )
		formatString: 0%
		displayFolder: 1. Backlog
		lineageTag: e02e171c-0114-4967-b403-62d25ca876e8

	/// Backlog at the end of the month of the axis (or the cutoff date if it is earlier), from two years before the cutoff year. Blank outside that range.
	measure 'Backlog At Month End' =
			VAR cutoff = [Cutoff Date]
			VAR fromVal = DATE ( YEAR ( cutoff ) - 2, 1, 1 )
			VAR inRange = NOT ISBLANK ( cutoff ) && MAX ( Dim_Calendar[Date] ) >= fromVal && MIN ( Dim_Calendar[Date] ) <= cutoff
			VAR t = MIN ( MAX ( Dim_Calendar[Date] ), cutoff )
			RETURN IF ( inRange, COUNTROWS ( CALCULATETABLE (
			        Fact_Orders,
			        REMOVEFILTERS ( Dim_Calendar ),
			        REMOVEFILTERS ( Dim_OrderStatus ),
			        Dim_WorkType[Counts In Backlog] = TRUE (),
			        Fact_Orders[In Backlog KPI] = TRUE (),
			        NOT ISBLANK ( Fact_Orders[Created Date] ) && Fact_Orders[Created Date] <= t,
			        ISBLANK ( Fact_Orders[Closure Date] ) || Fact_Orders[Closure Date] > t
			    ) ) + 0 )
		formatString: #,0
		displayFolder: 1. Backlog
		lineageTag: 70afcd7d-d3c8-4bdf-84df-1fa31881a7b8

	/// Baseline of the backlog as a horizontal line, only where [Backlog At Month End] has a value.
	measure 'Baseline Backlog Line' =
			IF ( NOT ISBLANK ( [Backlog At Month End] ), [Baseline Backlog] )
