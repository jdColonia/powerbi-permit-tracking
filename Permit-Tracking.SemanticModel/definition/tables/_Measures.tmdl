	/// Open orders created [Age Alert Days] days or more before the cutoff date (same boundary as the 12 to 24 age band).
	measure 'Aged Open Orders' =
			VAR todayDate = [Cutoff Date]
			VAR threshold = [Age Alert Days]
			RETURN
			    COUNTROWS (
			        FILTER (
			            CALCULATETABLE ( Fact_Orders, Dim_OrderStatus[Is Open] = TRUE () ),
			            DATEDIFF ( Fact_Orders[Created Date], todayDate, DAY ) >= threshold
			        )
			    )
		formatString: #,0
		displayFolder: 2. Open Orders
		lineageTag: c51f6566-f75b-4ab3-bf3c-8bb18af81eb4

	/// Open orders in the age band of the row (months since creation). Axis: Dim_AgeBand. Blank if no single band is in context.
	measure 'Open By Age' =
			VAR fromVal = SELECTEDVALUE ( Dim_AgeBand[From Days] )
			VAR toVal = SELECTEDVALUE ( Dim_AgeBand[To Days] )
			VAR todayDate = [Cutoff Date]
			RETURN
			    IF (
			        HASONEVALUE ( Dim_AgeBand[Age Band Order] ),
			        COUNTROWS (
			            FILTER (
			                CALCULATETABLE ( Fact_Orders, Dim_OrderStatus[Is Open] = TRUE () ),
			                VAR d = DATEDIFF ( Fact_Orders[Created Date], todayDate, DAY )
			                RETURN d >= fromVal && ( ISBLANK ( toVal ) || d < toVal )
			            )
			        )
			    )
		formatString: #,0
		displayFolder: 2. Open Orders
		lineageTag: 237b5a00-3297-4a98-a08c-0e9ad4a1d236

	/// Title of the open orders detail table: how many open orders there are for the selected work type, or for all work types. Bilingual.
	measure 'Open Detail Title' =
			VAR n = FORMAT ( [Open Orders] + 0, "#,0", [Locale] )
			VAR typeLabel = SWITCH ( [Lang], "en", SELECTEDVALUE ( Dim_WorkType[Work Type Description EN] ), SELECTEDVALUE ( Dim_WorkType[Work Type Description ES] ) )
			RETURN
			    IF (
			        HASONEVALUE ( Dim_WorkType[WorkTypeKey] ),
			        SWITCH ( [Lang], "en", "Open orders of " & typeLabel & ": " & n, "Órdenes abiertas de " & typeLabel & ": " & n ),
			        SWITCH ( [Lang], "en", "Open orders of all work types: " & n, "Órdenes abiertas de todos los tipos de trabajo: " & n )
			    )
		displayFolder: 2. Open Orders
		lineageTag: 6c86f70d-b004-43f1-b584-7a3c390768eb

	/// Average calendar days from creation to closure of the closed backlog orders, leaving out requests outside the data scope (their filing is not in the data).
	measure 'Avg Days To Close' =
			AVERAGEX (
			    FILTER (
			        CALCULATETABLE ( Fact_Orders, Dim_OrderStatus[Is Closed] = TRUE (), Fact_Orders[Outside Data Scope] <> TRUE (), Dim_WorkType[Counts In Backlog] = TRUE () ),
			        NOT ISBLANK ( Fact_Orders[Created Date] ) && NOT ISBLANK ( Fact_Orders[Closure Date] )
			    ),
			    DATEDIFF ( Fact_Orders[Created Date], Fact_Orders[Closure Date], DAY )
			)
		formatString: #,0
		displayFolder: 3. Closed Orders
		lineageTag: 4a6d57d4-9afd-4d52-8ba2-f50adb29f197

	/// Average calendar days from creation to closure of the closed Filing orders, leaving out requests outside the data scope.
	measure 'Avg Days Filing' =
			AVERAGEX (
			    FILTER (
			        CALCULATETABLE ( Fact_Orders, Dim_OrderStatus[Is Closed] = TRUE (), Fact_Orders[Outside Data Scope] <> TRUE (), Dim_WorkType[Group Key] = "Filing" ),
			        NOT ISBLANK ( Fact_Orders[Created Date] ) && NOT ISBLANK ( Fact_Orders[Closure Date] )
			    ),
			    DATEDIFF ( Fact_Orders[Created Date], Fact_Orders[Closure Date], DAY )
			)
		formatString: #,0
		displayFolder: 3. Closed Orders
		lineageTag: b5ff3af7-6243-46b9-95aa-34f6304c6e16

	/// Orders created in the period (uses the creation date relationship instead of the closure date).
	measure 'Orders Created In Period' =
			CALCULATE ( COUNTROWS ( Fact_Orders ), USERELATIONSHIP ( Fact_Orders[Created Date], Dim_Calendar[Date] ) )
		formatString: #,0
		displayFolder: 3. Closed Orders
		lineageTag: e2628a84-b383-4bf4-8f3d-4cc3d57e8e56

	/// Closed orders divided by orders created in the period. Above 1 the backlog goes down.
	measure 'Closed Per Created Order' =
			DIVIDE ( [Closed Orders], [Orders Created In Period] )
		formatString: 0.00
		displayFolder: 3. Closed Orders
		lineageTag: caad32b3-f719-4830-aa90-a1e8fc76e834

	/// Hidden. Accent colour of the closure ratio card: green when at least 1 order is closed per order created (the backlog shrinks), amber below 1.
	measure 'Color Closure Ratio' =
			VAR r = [Closed Per Created Order]
			RETURN IF ( NOT ISBLANK ( r ), IF ( r >= 1, "#1A7F4B", "#B07F0C" ) )
		isHidden
		displayFolder: 3. Closed Orders
		lineageTag: 5d0c5ac1-6f0e-4f55-9d35-1a6d3d5b0a11

	/// Orders closed in the month of the axis. Without a date filter it shows only the last 6 months; with a year or month filter it shows the filtered period.
	measure 'Closed Orders By Month' =
			VAR endDate = MAX ( Dim_Calendar[Date] )
			VAR todayDate = [Cutoff Date]
			RETURN
			    IF (
			        ISFILTERED ( Dim_Calendar[Date] ) || ISFILTERED ( Dim_Calendar[Year] ) || ISFILTERED ( Dim_Calendar[Month Name ES] ) || ISFILTERED ( Dim_Calendar[Month Name EN] )
			            || ( endDate > EOMONTH ( todayDate, -6 ) && endDate <= EOMONTH ( todayDate, 0 ) ),
			        [Closed Orders]
			    )
		formatString: #,0
		displayFolder: 3. Closed Orders
		lineageTag: 788a0770-05b0-4664-b0c2-6388105c5614

	/// Average days to close of the orders closed in the month of the axis. Same period rule as [Closed Orders By Month].
	measure 'Avg Days To Close By Month' =
			VAR endDate = MAX ( Dim_Calendar[Date] )
			VAR todayDate = [Cutoff Date]
			RETURN
			    IF (
			        ISFILTERED ( Dim_Calendar[Date] ) || ISFILTERED ( Dim_Calendar[Year] ) || ISFILTERED ( Dim_Calendar[Month Name ES] ) || ISFILTERED ( Dim_Calendar[Month Name EN] )
			            || ( endDate > EOMONTH ( todayDate, -6 ) && endDate <= EOMONTH ( todayDate, 0 ) ),
			        [Avg Days To Close]
			    )
		formatString: #,0
		displayFolder: 3. Closed Orders
		lineageTag: ce56f671-385b-4cf3-9dc4-62a9bc754851

	/// Value of the managed permits before VAT, by creation date of the order.
	measure 'Permit Value' =
			CALCULATE ( SUM ( Fact_Orders[Permit Cost] ), USERELATIONSHIP ( Fact_Orders[Created Date], Dim_Calendar[Date] ) )
		formatString: \C\O\P #,0
		displayFolder: 4. Costs
		lineageTag: cfc9b1a7-ff31-4ceb-898f-40f4df1563b9

	/// Part of the permit value paid when the permit is filed (rate share of Rates), before VAT.
	measure 'Paid At Filing' =
			CALCULATE ( SUM ( Fact_Orders[Payment At Filing] ), USERELATIONSHIP ( Fact_Orders[Created Date], Dim_Calendar[Date] ) )
		formatString: \C\O\P #,0
		displayFolder: 4. Costs
		lineageTag: d412b981-d29d-41d8-bfba-a996599dfb10

	/// Rest of the value of closed orders whose permit was delivered (result Granted), before VAT.
	measure 'Delivery Confirmed' =
			CALCULATE ( SUM ( Fact_Orders[Payment Delivery Confirmed] ), USERELATIONSHIP ( Fact_Orders[Created Date], Dim_Calendar[Date] ) )
		formatString: \C\O\P #,0
		displayFolder: 4. Costs
		lineageTag: fe5fe37d-7d6c-48a2-85fe-bae43290930c

	/// Rest of the value of open orders: the permit may already be delivered, but the data does not say it.
	measure 'Pending Confirmation' =
			CALCULATE ( SUM ( Fact_Orders[Payment Pending Confirmation] ), USERELATIONSHIP ( Fact_Orders[Created Date], Dim_Calendar[Date] ) )
		formatString: \C\O\P #,0
		displayFolder: 4. Costs
		lineageTag: b5fbcebc-263b-4234-9f05-1f433f5d3f57

	/// Hidden. [Paid At Filing] in millions of COP for the cost chart; the format shows "COP 12.3M" in English and "COP 12,3 M" in Spanish (the unit is part of the dynamic format).
	measure 'Paid At Filing Chart' =
			DIVIDE ( [Paid At Filing], 1000000 )
		isHidden
		displayFolder: 4. Costs
		lineageTag: 539283ff-b0b9-4f54-942d-71157713d599
		formatStringDefinition = SWITCH ( [Lang], "en", "\C\O\P #,0.0\M", "\C\O\P #,0.0\ \M" )

	/// Hidden. [Delivery Confirmed] in millions of COP for the cost chart; the format shows "COP 12.3M" in English and "COP 12,3 M" in Spanish (the unit is part of the dynamic format).
	measure 'Delivery Confirmed Chart' =
			DIVIDE ( [Delivery Confirmed], 1000000 )
		isHidden
		displayFolder: 4. Costs
		lineageTag: 0a41cea8-0193-4e80-a231-b77a43b62e40
		formatStringDefinition = SWITCH ( [Lang], "en", "\C\O\P #,0.0\M", "\C\O\P #,0.0\ \M" )

	/// Hidden. [Pending Confirmation] in millions of COP for the cost chart; the format shows "COP 12.3M" in English and "COP 12,3 M" in Spanish (the unit is part of the dynamic format).
	measure 'Pending Confirmation Chart' =
			DIVIDE ( [Pending Confirmation], 1000000 )
		isHidden
		displayFolder: 4. Costs
		lineageTag: 2ad99bdb-8332-4401-9b70-1d8becb5b915
		formatStringDefinition = SWITCH ( [Lang], "en", "\C\O\P #,0.0\M", "\C\O\P #,0.0\ \M" )

	/// Orders that have a cost (a rate applies), by creation date.
	measure 'Permits Managed' =
			CALCULATE ( COUNTROWS ( FILTER ( Fact_Orders, NOT ISBLANK ( Fact_Orders[Permit Cost] ) ) ), USERELATIONSHIP ( Fact_Orders[Created Date], Dim_Calendar[Date] ) )
		formatString: #,0
		displayFolder: 4. Costs
		lineageTag: 3dcc052f-fca6-44ed-9471-f4c6475e0d4e

	/// Text of [Paid At Filing] in millions of pesos ("COP 12.3M").
	measure 'Paid At Filing Millions' =
			VAR v = [Paid At Filing]
			RETURN
			    IF (
			        NOT ISBLANK ( v ),
			        "COP " & FORMAT ( v / 1000000, "#,0.0", [Locale] ) & SWITCH ( [Lang], "en", "M", " M" ),
			        "COP " & FORMAT ( 0, "#,0.0", [Locale] ) & SWITCH ( [Lang], "en", "M", " M" )
			    )
		displayFolder: 4. Costs
		lineageTag: da30b5b8-9a5e-4833-9d7c-7f998800dafb

	/// Text of [Delivery Confirmed] in millions of Colombian pesos (COP).
	measure 'Delivery Confirmed Millions' =
			VAR v = [Delivery Confirmed]
			RETURN
			    IF (
			        NOT ISBLANK ( v ),
			        "COP " & FORMAT ( v / 1000000, "#,0.0", [Locale] ) & SWITCH ( [Lang], "en", "M", " M" ),
			        "COP " & FORMAT ( 0, "#,0.0", [Locale] ) & SWITCH ( [Lang], "en", "M", " M" )
			    )
		displayFolder: 4. Costs
		lineageTag: fd3fb591-4063-459d-b04e-d70813539c2e

	/// Text of [Pending Confirmation] in millions of Colombian pesos (COP).
	measure 'Pending Confirmation Millions' =
			VAR v = [Pending Confirmation]
			RETURN
			    IF (
			        NOT ISBLANK ( v ),
			        "COP " & FORMAT ( v / 1000000, "#,0.0", [Locale] ) & SWITCH ( [Lang], "en", "M", " M" ),
			        "COP " & FORMAT ( 0, "#,0.0", [Locale] ) & SWITCH ( [Lang], "en", "M", " M" )
			    )
		displayFolder: 4. Costs
		lineageTag: 1d2e839e-c4ff-4b3e-9a40-4ac66653bf0b

	/// Hidden. 1 if the order of the row has a cost, 0 if not. Used to hide rows without cost in the cost detail table.
	measure 'Has Cost Flag' =
			IF ( NOT ISBLANK ( SUM ( Fact_Orders[Permit Cost] ) ), 1, 0 )
		formatString: 0
		isHidden
		displayFolder: 4. Costs
		lineageTag: 2015dc97-8d03-4d74-bb14-7c06338ddc71

	/// Title of the cost detail table with the number of managed permits. Bilingual.
	measure 'Cost Detail Title' =
			VAR n = [Permits Managed]
			RETURN
			    SWITCH (
			        [Lang],
			        "en", "Managed permit details (" & FORMAT ( n, "#,0", [Locale] ) & ")",
			        "Detalle de los permisos gestionados (" & FORMAT ( n, "#,0", [Locale] ) & ")"
			    )
		displayFolder: 4. Costs
		lineageTag: c7215337-94a0-4f0b-a340-364602333af2

	/// Value text of the KPI card selected by the key of KpiCards.
	measure 'Card Value Text' =
			VAR k = SELECTEDVALUE ( KpiCards[Key] )
			RETURN
			    SWITCH (
			        k,
			        "Backlog", [KPI Text Backlog],
			        "Age", [KPI Text Age],
			        "Handling", [KPI Text Handling],
			        "Municipal", [KPI Text Municipal]
			    )
		displayFolder: 1. Backlog\KPI Cards
		lineageTag: e2e92d26-bbb0-4df0-af45-63c63b4ad6d2

	/// Baseline text of the KPI card selected by the key of KpiCards.
	measure 'Card Baseline Text' =
			VAR k = SELECTEDVALUE ( KpiCards[Key] )
			RETURN
			    SWITCH (
			        k,
			        "Backlog", [Baseline Text Backlog],
			        "Age", [Baseline Text Age],
			        "Handling", [Baseline Text Handling],
			        "Municipal", [Baseline Text Municipal]
			    )
		displayFolder: 1. Backlog\KPI Cards
		lineageTag: 8977f30d-3f17-4855-afd6-fbc958a63156

	/// Text of the baseline dates of the KPI card selected by the key of KpiCards.
	measure 'Card Baseline Range Text' =
			VAR k = SELECTEDVALUE ( KpiCards[Key] )
			RETURN
			    SWITCH (
			        k,
			        "Backlog", [Baseline Range Backlog],
			        "Age", [Baseline Range Age],
			        "Handling", [Baseline Range Handling],
			        "Municipal", [Baseline Range Municipal]
			    )
		displayFolder: 1. Backlog\KPI Cards
		lineageTag: 2deae9c5-c70a-439b-9426-af9702ad366c

	/// Target text of the KPI card selected by the key of KpiCards.
	measure 'Card Target Text' =
			VAR k = SELECTEDVALUE ( KpiCards[Key] )
			RETURN
			    SWITCH (
			        k,
			        "Backlog", [Target Text Backlog],
			        "Age", [Target Text Age],
			        "Handling", [Target Text Handling],
			        "Municipal", [Target Text Municipal]
			    )
		displayFolder: 1. Backlog\KPI Cards
		lineageTag: 8a540271-8422-4ff9-8ec8-fbb64752a34c

	/// Variation text (pill) of the KPI card selected by the key of KpiCards.
	measure 'Card Variation Text' =
			VAR k = SELECTEDVALUE ( KpiCards[Key] )
			RETURN
			    SWITCH (
			        k,
			        "Backlog", [Variation Text Backlog],
			        "Age", [Variation Text Age],
			        "Handling", [Variation Text Handling],
			        "Municipal", [Variation Text Municipal]
			    )
		displayFolder: 1. Backlog\KPI Cards
		lineageTag: fd0037fa-384f-494f-a13b-de852f946827

	/// Expected reduction range text of the KPI card selected by the key of KpiCards.
	measure 'Card Target Range' =
			VAR k = SELECTEDVALUE ( KpiCards[Key] )
			RETURN
			    SWITCH (
			        k,
			        "Backlog", [Target Range Backlog],
			        "Age", [Target Range Age],
			        "Handling", [Target Range Handling],
			        "Municipal", [Target Range Municipal]
			    )
		displayFolder: 1. Backlog\KPI Cards
		lineageTag: 6a3ccacb-ae0d-48ab-a166-55a0d2981d9a

	/// Numeric variation of the KPI card selected by the key of KpiCards. Colours the pill.
	measure 'Card Variation' =
			VAR k = SELECTEDVALUE ( KpiCards[Key] )
			RETURN
			    SWITCH (
			        k,
			        "Backlog", [Variation Backlog],
			        "Age", [Variation Age],
			        "Handling", [Variation Handling],
			        "Municipal", [Variation Municipal]
			    )
		formatString: 0.0%
		displayFolder: 1. Backlog\KPI Cards
		lineageTag: 464d2cd5-5501-4b6f-8c9e-b53e28b82f0a

	/// Progress from baseline to target of the KPI card selected by the key of KpiCards. Length of the progress bar.
	measure 'Card Progress' =
			VAR k = SELECTEDVALUE ( KpiCards[Key] )
			RETURN
			    SWITCH (
			        k,
			        "Backlog", [Progress Backlog],
			        "Age", [Progress Age],
			        "Handling", [Progress Handling],
			        "Municipal", [Progress Municipal]
			    )
		formatString: 0%
		displayFolder: 1. Backlog\KPI Cards
		lineageTag: eecd1bb8-9ef8-442d-8fa0-e8b89fe9232b

	/// Hidden flag: 1 if the KPI card already reached its target. Colours the bar and the pill green.
	measure 'Card Target Met' =
			VAR k = SELECTEDVALUE ( KpiCards[Key] )
			RETURN
			    SWITCH (
			        k,
			        "Backlog", [Target Met Backlog],
			        "Age", [Target Met Age],
			        "Handling", [Target Met Handling],
			        "Municipal", [Target Met Municipal]
			    )
		formatString: 0
		displayFolder: 1. Backlog\KPI Cards
		lineageTag: 9df0939b-7a8e-44b5-bcb3-38073b9e7163

	column Placeholder
		isHidden
		lineageTag: 4b39d0b3-83cf-4b8b-ae73-8566a06b7678
