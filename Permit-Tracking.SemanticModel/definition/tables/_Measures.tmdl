		formatString: #,0
		displayFolder: 1. Backlog
		lineageTag: 7da9aa99-80ed-4f19-bce3-4c7c5eb5c9a2

	/// Orders created in the quarter of the axis (backlog work types), using the creation date relationship. Blank outside the two-year range.
	measure 'New Orders By Quarter' =
			VAR cutoff = [Cutoff Date]
			VAR fromVal = DATE ( YEAR ( cutoff ) - 2, 1, 1 )
			VAR inRange = NOT ISBLANK ( cutoff ) && MAX ( Dim_Calendar[Date] ) >= fromVal && MIN ( Dim_Calendar[Date] ) <= cutoff
			RETURN
			    IF (
			        inRange,
			        CALCULATE (
			            COUNTROWS ( Fact_Orders ),
			            USERELATIONSHIP ( Fact_Orders[Created Date], Dim_Calendar[Date] ),
			            REMOVEFILTERS ( Dim_OrderStatus ),
			            Dim_WorkType[Counts In Backlog] = TRUE ()
			        ) + 0
			    )
		formatString: #,0
		displayFolder: 1. Backlog
		lineageTag: 950bcb3d-b2f4-48fc-a947-6bf2d528febe

	/// Orders closed in the quarter of the axis (backlog work types) without administrative closures. Blank outside the two-year range.
	measure 'Closed Orders By Quarter' =
			VAR cutoff = [Cutoff Date]
			VAR fromVal = DATE ( YEAR ( cutoff ) - 2, 1, 1 )
			VAR inRange = NOT ISBLANK ( cutoff ) && MAX ( Dim_Calendar[Date] ) >= fromVal && MIN ( Dim_Calendar[Date] ) <= cutoff
			RETURN
			    IF (
			        inRange,
			        CALCULATE (
			            COUNTROWS ( Fact_Orders ),
			            REMOVEFILTERS ( Dim_OrderStatus ),
			            Dim_WorkType[Counts In Backlog] = TRUE (),
			            NOT ISBLANK ( Fact_Orders[Closure Date] ),
			            Dim_ClosureReason[Result Key] <> "AdminClosure"
			        ) + 0
			    )
		formatString: #,0
		displayFolder: 1. Backlog
		lineageTag: 6cc6521d-6f82-4e9c-95b3-a089c35b5ef7

	/// Orders closed in the quarter by administrative closure (the order was not needed). Blank outside the two-year range.
	measure 'Admin Closures By Quarter' =
			VAR cutoff = [Cutoff Date]
			VAR fromVal = DATE ( YEAR ( cutoff ) - 2, 1, 1 )
			VAR inRange = NOT ISBLANK ( cutoff ) && MAX ( Dim_Calendar[Date] ) >= fromVal && MIN ( Dim_Calendar[Date] ) <= cutoff
			RETURN
			    IF (
			        inRange,
			        CALCULATE (
			            COUNTROWS ( Fact_Orders ),
			            REMOVEFILTERS ( Dim_OrderStatus ),
			            Dim_WorkType[Counts In Backlog] = TRUE (),
			            NOT ISBLANK ( Fact_Orders[Closure Date] ),
			            Dim_ClosureReason[Result Key] = "AdminClosure"
			        ) + 0
			    )
		formatString: #,0
		displayFolder: 1. Backlog
		lineageTag: 720b5ca7-f9a9-451e-93f0-a609de155cf2

	/// Average age of the open backlog at the end of the quarter of the axis. Blank outside the two-year range.
	measure 'Avg Age At Quarter End' =
			VAR cutoff = [Cutoff Date]
			VAR fromVal = DATE ( YEAR ( cutoff ) - 2, 1, 1 )
			VAR inRange = NOT ISBLANK ( cutoff ) && MAX ( Dim_Calendar[Date] ) >= fromVal && MIN ( Dim_Calendar[Date] ) <= cutoff
			VAR t = MIN ( MAX ( Dim_Calendar[Date] ), cutoff )
			RETURN IF ( inRange, AVERAGEX ( CALCULATETABLE (
			        Fact_Orders,
			        REMOVEFILTERS ( Dim_Calendar ),
			        REMOVEFILTERS ( Dim_OrderStatus ),
			        Dim_WorkType[Counts In Backlog] = TRUE (),
			        Fact_Orders[In Backlog KPI] = TRUE (),
			        NOT ISBLANK ( Fact_Orders[Created Date] ) && Fact_Orders[Created Date] <= t,
			        ISBLANK ( Fact_Orders[Closure Date] ) || Fact_Orders[Closure Date] > t
