	/// Baseline of Granting (calendar days): the Fixed Baseline of Targets if it has one; otherwise the same calculation as the indicator at the baseline cutoff (Baseline Cutoff and Baseline Created Until of Targets; without a cutoff, the end of the day of [Baseline Date]). Basis: the same average, with the N-month window that ends on the baseline day.
	measure 'Baseline Granting' =
			VAR fixedValue = LOOKUPVALUE ( Targets[Fixed Baseline], Targets[Key], "Granting" )
			RETURN
			    IF (
			        NOT ISBLANK ( fixedValue ),
			        fixedValue,
			        VAR cutoff = LOOKUPVALUE ( Targets[Baseline Cutoff], Targets[Key], "Granting" )
			        VAR toVal = LOOKUPVALUE ( Targets[Baseline Created Until], Targets[Key], "Granting" )
			        VAR T = IF ( ISBLANK ( cutoff ), [Baseline Date] + 1 - TIME ( 0, 0, 1 ), cutoff )
			        VAR H = IF ( ISBLANK ( toVal ), T, toVal + 1 - TIME ( 0, 0, 1 ) )
			        VAR cutDay = DATE ( YEAR ( T ), MONTH ( T ), DAY ( T ) )
			        VAR windowStart = EDATE ( cutDay, - [Time Window Months] )
			        RETURN
			            AVERAGEX (
			                CALCULATETABLE (
			                    Fact_Permits,
			                    REMOVEFILTERS ( Dim_Calendar ),
			                    Fact_Permits[Granted Date] > windowStart,
			                    Fact_Permits[Granted Date] <= cutDay
			                ),
			                Fact_Permits[Granting Days]
			            )
			    )
		formatString: #,0
		displayFolder: 1. Backlog\Granting KPI
		lineageTag: 2fe2d8fe-5046-41a6-8c37-2d06b4824677

	/// Target of Granting (calendar days): baseline x (1 - midpoint of the reduction range in Targets), rounded. Blank if the baseline or the reduction is missing. Lower is better.
	measure 'Target Granting' =
			VAR r = LOOKUPVALUE ( Targets[Target Reduction], Targets[Key], "Granting" )
			VAR b = [Baseline Granting]
			RETURN IF ( NOT ISBLANK ( b ) && NOT ISBLANK ( r ), ROUND ( b * ( 1 - r ), 0 ) )
		formatString: #,0
		displayFolder: 1. Backlog\Granting KPI
		lineageTag: c2ffa455-34f8-428f-b5b8-8aace4b82d1c

	/// Current handling time: average calendar days between creation and closure of all the closed orders of the backlog work types created since Handling Start, with every closure reason, administrative closures included, leaving out requests outside the data scope (same rule as the Closed orders page). KPI card of the Backlog page.
	measure 'KPI Handling' =
			VAR T = [Cutoff Date] + 1 - TIME ( 0, 0, 1 )
			VAR H = T
			VAR cutDay = DATE ( YEAR ( T ), MONTH ( T ), DAY ( T ) )
			RETURN
			    AVERAGEX (
			        CALCULATETABLE (
			            Fact_Orders,
			            REMOVEFILTERS ( Dim_Calendar ),
			            REMOVEFILTERS ( Dim_OrderStatus ),
			            Dim_WorkType[Counts In Backlog] = TRUE (),
			            Fact_Orders[In Handling KPI] = TRUE (),
			            Fact_Orders[Outside Data Scope] <> TRUE (),
			            NOT ISBLANK ( Fact_Orders[Created At] ) && Fact_Orders[Created At] <= H,
			            NOT ISBLANK ( Fact_Orders[Closed At] ) && Fact_Orders[Closed At] <= T
			        ),
			        DATEDIFF ( Fact_Orders[Created Date], Fact_Orders[Closure Date], DAY )
			    )
		formatString: #,0
		displayFolder: 1. Backlog\Handling KPI
		lineageTag: 03c192bf-8f58-49d3-b0d9-605a72a94270

	/// Baseline of Handling (calendar days): the Fixed Baseline of Targets if it has one; otherwise the same calculation as the indicator at the baseline cutoff (Baseline Cutoff and Baseline Created Until of Targets; without a cutoff, the end of the day of [Baseline Date]). Basis: closed orders created and closed up to the cutoffs of Targets.
	measure 'Baseline Handling' =
			VAR fixedValue = LOOKUPVALUE ( Targets[Fixed Baseline], Targets[Key], "Handling" )
			RETURN
			    IF (
			        NOT ISBLANK ( fixedValue ),
			        fixedValue,
			        VAR cutoff = LOOKUPVALUE ( Targets[Baseline Cutoff], Targets[Key], "Handling" )
			        VAR toVal = LOOKUPVALUE ( Targets[Baseline Created Until], Targets[Key], "Handling" )
			        VAR T = IF ( ISBLANK ( cutoff ), [Baseline Date] + 1 - TIME ( 0, 0, 1 ), cutoff )
			        VAR H = IF ( ISBLANK ( toVal ), T, toVal + 1 - TIME ( 0, 0, 1 ) )
			        VAR cutDay = DATE ( YEAR ( T ), MONTH ( T ), DAY ( T ) )
			        RETURN
			            AVERAGEX (
			                CALCULATETABLE (
			                    Fact_Orders,
			                    REMOVEFILTERS ( Dim_Calendar ),
			                    REMOVEFILTERS ( Dim_OrderStatus ),
			                    Dim_WorkType[Counts In Backlog] = TRUE (),
			                    Fact_Orders[In Handling KPI] = TRUE (),
			                    Fact_Orders[Outside Data Scope] <> TRUE (),
			                    NOT ISBLANK ( Fact_Orders[Created At] ) && Fact_Orders[Created At] <= H,
			                    NOT ISBLANK ( Fact_Orders[Closed At] ) && Fact_Orders[Closed At] <= T
			                ),
			                DATEDIFF ( Fact_Orders[Created Date], Fact_Orders[Closure Date], DAY )
			            )
			    )
		formatString: #,0
		displayFolder: 1. Backlog\Handling KPI
		lineageTag: 1317a871-6f31-4852-be99-88549396b787

	/// Target of Handling (calendar days): baseline x (1 - midpoint of the reduction range in Targets), rounded. Blank if the baseline or the reduction is missing. Lower is better.
	measure 'Target Handling' =
			VAR r = LOOKUPVALUE ( Targets[Target Reduction], Targets[Key], "Handling" )
			VAR b = [Baseline Handling]
			RETURN IF ( NOT ISBLANK ( b ) && NOT ISBLANK ( r ), ROUND ( b * ( 1 - r ), 0 ) )
		formatString: #,0
		displayFolder: 1. Backlog\Handling KPI
		lineageTag: 983c0f0b-3f23-4523-9eab-fc62eb3accdc

	/// KPI card text with the dates of the Handling baseline: "BASELINE: start - end". Start: the later of Handling Start and the first creation date in the data; end: the baseline cutoff day. Bilingual.
	measure 'Baseline Range Handling' =
			VAR cutoff = LOOKUPVALUE ( Targets[Baseline Cutoff], Targets[Key], "Handling" )
			VAR untilCreated = LOOKUPVALUE ( Targets[Baseline Created Until], Targets[Key], "Handling" )
			// T = baseline moment (no cutoff in Targets: end of the day of [Baseline Date]); H = last creation that counts (no value: same as T).
			VAR T = IF ( ISBLANK ( cutoff ), [Baseline Date] + 1 - TIME ( 0, 0, 1 ), cutoff )
			VAR H = IF ( ISBLANK ( untilCreated ), T, untilCreated + 1 - TIME ( 0, 0, 1 ) )
			// endDate = end of the range: the cutoff day, or the last creation date if it is earlier.
			VAR endDate = DATE ( YEAR ( MIN ( T, H ) ), MONTH ( MIN ( T, H ) ), DAY ( MIN ( T, H ) ) )
			RETURN
			    IF (
			        NOT ISBLANK ( endDate ),
			        SWITCH ( [Lang], "en", "BASELINE: ", "LÍNEA BASE: " )
			            & FORMAT ( MAX ( [Handling Start], [First Creation Date] ), [Date Format] ) & " – " & FORMAT ( endDate, [Date Format] )
			    )
		displayFolder: 1. Backlog\Handling KPI
		lineageTag: 8f6966e8-76d1-4a59-a557-ad1cb0f7bab1

	/// Relative variation of the current Handling against its baseline: (KPI - baseline) / baseline, as a percentage. Negative = improved (lower is better).
	measure 'Variation Handling' =
			DIVIDE ( [KPI Handling] - [Baseline Handling], [Baseline Handling] )
		formatString: 0.0%
