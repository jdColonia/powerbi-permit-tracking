/// Work types with group (Filing, Review, Standalone), responsible area and backlog flag. Edited in config_work_types.csv.
table Dim_WorkType
	lineageTag: be4a0a4b-d0eb-4256-8bbf-c81bddfab39c

	column WorkTypeKey
		dataType: string
		isHidden
		lineageTag: 944d8ddf-68c6-44eb-bbea-cd5a6326b933
		summarizeBy: none
		sourceColumn: WorkTypeKey

		annotation SummarizationSetBy = Automatic

	column 'Work Type Description ES'
		dataType: string
		lineageTag: 33e77c5b-d4ed-4c77-80f6-7b1ad64e1195
		summarizeBy: none
		sourceColumn: Work Type Description ES
		sortByColumn: 'Stage Order'

		annotation SummarizationSetBy = Automatic

	column 'Work Type Description EN'
		dataType: string
		lineageTag: d635688b-c392-5acf-92c0-4d8e60160e0e
		summarizeBy: none
		sourceColumn: Work Type Description EN
		sortByColumn: 'Stage Order'

		annotation SummarizationSetBy = Automatic

	/// Language-independent group: Filing, Review or Standalone. DAX rules use this column.
	column 'Group Key'
		dataType: string
		isHidden
		lineageTag: 0c5ea773-1581-425b-bf98-375ddd779493
		summarizeBy: none
		sourceColumn: Group Key
		sortByColumn: 'Group Order'

		annotation SummarizationSetBy = Automatic

	column 'Group ES'
		dataType: string
		lineageTag: 267cdb05-3db1-533f-8400-4122567da1a2
		summarizeBy: none
		sourceColumn: Group ES
		sortByColumn: 'Group Order'

		annotation SummarizationSetBy = Automatic

	column 'Group EN'
		dataType: string
		lineageTag: f686220e-43b7-53d1-87bc-c56b66ebd276
		summarizeBy: none
		sourceColumn: Group EN
		sortByColumn: 'Group Order'

		annotation SummarizationSetBy = Automatic

	column 'Group Order'
		dataType: int64
		isHidden
		lineageTag: 355eda76-93c9-49a3-ba92-f1822c7742a3
		summarizeBy: none
		sourceColumn: Group Order

		annotation SummarizationSetBy = Automatic

	/// Area responsible for the work type.
	column 'Area ES'
		dataType: string
		lineageTag: 17f36bb0-8b72-47f1-a949-e1d8c15a3251
		summarizeBy: none
		sourceColumn: Area ES

		annotation SummarizationSetBy = Automatic

	/// Area responsible for the work type.
	column 'Area EN'
		dataType: string
		lineageTag: 7aea131e-3bc3-5e53-9af0-3a23bcb4a657
		summarizeBy: none
		sourceColumn: Area EN

		annotation SummarizationSetBy = Automatic

	column 'Counts In Backlog'
		dataType: boolean
		lineageTag: e87b02b5-edcb-449d-87cd-e6f5f2afbf27
		summarizeBy: none
		sourceColumn: Counts In Backlog

