		annotation SummarizationSetBy = Automatic

	/// Rest of the rate of an open order: the permit may already be delivered, but the data does not say it.
	column 'Payment Pending Confirmation'
		dataType: double
		formatString: \C\O\P #,0
		lineageTag: 6cfe335c-0373-4c67-be20-2ed49f22c2ec
		summarizeBy: none
		sourceColumn: Payment Pending Confirmation

		annotation SummarizationSetBy = Automatic

	/// Delivery confirmed, Pending confirmation, Initial payment only or No payment.
	column 'Payment Stage ES'
		dataType: string
		lineageTag: 8b8482c7-1010-42fa-94a4-5cb61c2c6b89
		summarizeBy: none
		sourceColumn: Payment Stage ES

		annotation SummarizationSetBy = Automatic

	/// Delivery confirmed, Pending confirmation, Initial payment only or No payment.
	column 'Payment Stage EN'
		dataType: string
		lineageTag: 4ba84f80-7d75-5f8c-9cad-f596788839a4
		summarizeBy: none
		sourceColumn: Payment Stage EN

		annotation SummarizationSetBy = Automatic

	/// Year of the creation date of the order (axis and filter of the Costs page).
	column 'Created Year'
		dataType: int64
		formatString: 0
		lineageTag: ad335aad-0a51-4338-bbb4-b01e3e2679a0
		summarizeBy: none
		sourceColumn: Created Year

		annotation SummarizationSetBy = Automatic

	/// Created on or after the backlog start date (config_settings.csv).
	column 'In Backlog KPI'
		dataType: boolean
		isHidden
		lineageTag: e70cb973-0093-4b50-866d-1f522d3f5fbf
		summarizeBy: none
		sourceColumn: In Backlog KPI

		annotation SummarizationSetBy = Automatic

	/// Created on or after the handling time start date (config_settings.csv).
	column 'In Handling KPI'
		dataType: boolean
		isHidden
		lineageTag: 75e91a56-8d3f-4fc6-8616-4839a0a00352
		summarizeBy: none
		sourceColumn: In Handling KPI

		annotation SummarizationSetBy = Automatic

	/// Created on or after the permit filing time start date (config_settings.csv).
	column 'In Municipal KPI'
		dataType: boolean
		isHidden
		lineageTag: 8bf8b835-1ca9-4abc-a494-60c7d7ba0f86
		summarizeBy: none
		sourceColumn: In Municipal KPI

		annotation SummarizationSetBy = Automatic

	partition Fact_Orders = m
		mode: import
		queryGroup: '5. Facts'
		source =
				let
				    // ---------- Fact columns and keys ----------
				    // All the orders the dashboard loads (the work types of the catalog; the permit ones are the same as OrdersPermits)
				    Source = OrdersUnique,
				
				    Columns = Table.SelectColumns(Source, {
				        "Order ID",
				        "Request ID",
				        "Order Type",
				        "Order Status Code",
				        "Closure Reason Code",
				        "Location Code",
				        "Work Unit Code",
				        "Order Created At",
				        "Order Assigned At",
				        "Order Closed At",
				        "Order Created DateTime",
				        "Order Closed DateTime",
				        "Closed By Name"
				    }),
				
				    // Keys are renamed like the column of their dimension (WorkTypeKey, OrderStatusKey...) for the relationships
				    Renamed = Table.RenameColumns(Columns, {
				        {"Order Type", "WorkTypeKey"},
				        {"Order Status Code", "OrderStatusKey"},
				        {"Closure Reason Code", "ClosureReasonKey"},
				        {"Location Code", "LocationKey"},
				        {"Work Unit Code", "WorkUnitKey"},
				        {"Order Created At", "Created Date"},
				        {"Order Assigned At", "Assignment Date"},
				        {"Order Closed At", "Closure Date"},
				        {"Order Created DateTime", "Created At"},
				        {"Order Closed DateTime", "Closed At"}
				    }),
				
				    // ---------- Requests outside the data scope ----------
				    // Requests that start with a review (their filing is not in the data): the list is already in memory (RequestsOutsideData)
				    OutsideRequests = RequestsOutsideData,
				    OutsideRecord = Record.FromList(List.Repeat({true}, List.Count(OutsideRequests)), List.Transform(OutsideRequests, Text.From)),
				    WithOutside = Table.AddColumn(Renamed, "Outside Data Scope", each
				        [Request ID] <> null and Record.HasFields(OutsideRecord, Text.From([Request ID])), type logical),
				
				    // ---------- Cost of managing the permit ----------
				    // Support data: Permit Group Key of the work type (Dim_WorkType), Result Key of the closure reason
				    // (Dim_ClosureReason) and Km of the order (OrderKm); Km and VAT stay as helper columns (_Km, _VAT) used to compute the cost
				    Groups = Table.SelectColumns(Dim_WorkType, {"WorkTypeKey", "Permit Group Key"}),
				    Results = Table.SelectColumns(Dim_ClosureReason, {"ClosureReasonKey", "Result Key"}),
				    WithGroup = Table.ExpandTableColumn(Table.NestedJoin(WithOutside, {"WorkTypeKey"}, Groups, {"WorkTypeKey"}, "G", JoinKind.LeftOuter), "G", {"Permit Group Key"}, {"_Group"}),
				    WithResult = Table.ExpandTableColumn(Table.NestedJoin(WithGroup, {"ClosureReasonKey"}, Results, {"ClosureReasonKey"}, "R", JoinKind.LeftOuter), "R", {"Result Key"}, {"_Result"}),
				    WithKm = Table.ExpandTableColumn(Table.NestedJoin(WithResult, {"Order ID"}, OrderKm, {"Order ID"}, "K", JoinKind.LeftOuter), "K", {"Km"}, {"_Km"}),
				    // Rates in memory; fnRate finds the one in force on the creation date of the order
				    RatesBuffered = Table.Buffer(Rates),
				    // Rate of a group on a date: the latest one whose validity starts on or before that date (no date:
				    // the most recent). If the date is before the first validity, the first one is used.
				    // No group or no rate: null
				    fnRate = (group as nullable text, onDate as any) as nullable record =>
				        let
				            ofGroup = Table.SelectRows(RatesBuffered, each [Permit Group Key] = group),
				            d = if onDate is datetime then Date.From(onDate) else onDate,
				            valid = if d = null then ofGroup else Table.SelectRows(ofGroup, each [Valid From] <= d)
				        in
				            if group = null or Table.IsEmpty(ofGroup) then null
				            else if Table.IsEmpty(valid) then Table.First(Table.Sort(ofGroup, {{"Valid From", Order.Ascending}}))
				            else Table.Last(Table.Sort(valid, {{"Valid From", Order.Ascending}})),
				    // Cost before VAT, VAT and payment at filing (null if the order is not charged)
				    WithCost = Table.AddColumn(WithKm, "_C", each
				        let
				            // r = rate in force; orders closed by administrative closure are not charged
				            r = if [_Result] = "AdminClosure" then null else fnRate([_Group], [Created Date]),
				            km = [_Km],
				            // Value before VAT: no per-km value, no km or up to the fixed-km limit -> fixed value;
				            // beyond the max km -> no value; otherwise km x per-km value
				            value =
				                if r = null then null
				                else if r[Value Per Km] = null or km = null or km <= (if r[Max Fixed Km] = null then 0 else r[Max Fixed Km]) then r[Fixed Value]
				                else if r[Max Km] <> null and km > r[Max Km] then null
				                else km * r[Value Per Km]
				        in
				            [Cost = value, VAT = if value = null then null else value * r[VAT Rate],
				             AtFiling = if value = null then null else value * r[Filing Payment Rate]]),
				    // The cost record is opened into columns
				    Expanded = Table.ExpandRecordColumn(WithCost, "_C", {"Cost", "VAT", "AtFiling"},
				        {"Permit Cost", "_VAT", "Payment At Filing"}),
				
				    // ---------- When it is paid ----------
				    // rest = what is not paid at filing; isOpen = no closure date; delivered = closed with result Granted
				    WithPayments = Table.AddColumn(Expanded, "_P", each
				        let
				            rest = if [Permit Cost] = null then null else [Permit Cost] - [Payment At Filing],
				            isOpen = [Closure Date] = null,
				            delivered = [_Result] = "Granted"
				        in
				            // No cost, no payment stages; otherwise: delivered -> the rest is confirmed; open
				            // -> pending confirmation; closed without delivery -> only what was paid at filing
				            if rest = null then [Delivery = null, Pending = null, StageES = null, StageEN = null]
				            else [
				                Delivery = if delivered then rest else 0,
				                Pending = if isOpen then rest else 0,
				                StageES = if delivered then "Entrega confirmada" else if isOpen then "Por confirmar"
				                    else if [Payment At Filing] > 0 then "Solo pago inicial" else "Sin pago",
				                StageEN = if delivered then "Delivery confirmed" else if isOpen then "Pending confirmation"
				                    else if [Payment At Filing] > 0 then "Initial payment only" else "No payment"
				            ]),
				    WithStages = Table.ExpandRecordColumn(WithPayments, "_P", {"Delivery", "Pending", "StageES", "StageEN"},
				        {"Payment Delivery Confirmed", "Payment Pending Confirmation", "Payment Stage ES", "Payment Stage EN"}),
				    // Cost with VAT, creation year and types
				    WithTotal = Table.AddColumn(WithStages, "Permit Cost With VAT", each if [Permit Cost] = null then null else [Permit Cost] + [_VAT], type number),
				    WithYear = Table.AddColumn(WithTotal, "Created Year", each if [Created Date] = null then null else Date.Year([Created Date]), Int64.Type),
				    Typed = Table.TransformColumnTypes(WithYear, {{"Permit Cost", type number},
				        {"Payment At Filing", type number}, {"Payment Delivery Confirmed", type number}, {"Payment Pending Confirmation", type number},
				        {"Payment Stage ES", type text}, {"Payment Stage EN", type text}}),
				
				    // ---------- KPI windows ----------
				    // Start dates of each indicator (settings, a single row)
				    Starts = Settings{0},
				    fnFrom = (f as any, start as date) as logical => f <> null and Date.From(f) >= start,
				    // An order counts in an indicator if it was created on or after its start date
				    WithWindows = Table.AddColumn(Table.AddColumn(Table.AddColumn(Typed,
				        "In Backlog KPI", each fnFrom([Created Date], Starts[Backlog Start]), type logical),
				        "In Handling KPI", each fnFrom([Created Date], Starts[Handling Start]), type logical),
				        "In Municipal KPI", each fnFrom([Created Date], Starts[Municipal Start]), type logical),
				    // Drop the helper columns
				    Final = Table.RemoveColumns(WithWindows, {"_Group", "_Result", "_Km", "_VAT"})
				in
				    Final

	annotation PBI_ResultType = Table
