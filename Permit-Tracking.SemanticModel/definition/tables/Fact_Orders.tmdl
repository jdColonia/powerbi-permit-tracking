		annotation SummarizationSetBy = Automatic

	/// Rest of the rate if the order was closed with the permit granted.
	column 'Payment Delivery Confirmed'
		dataType: double
		formatString: \C\O\P #,0
		lineageTag: 4a338942-0465-4f42-a00b-57386fa51140
		summarizeBy: none
