	/// Part of the rate paid when the permit is filed (Filing Payment Rate of Rates), before VAT.
	column 'Payment At Filing'
		dataType: double
		formatString: \C\O\P #,0
		lineageTag: fa067683-78cd-4158-8cd4-c2d39ce32910
		summarizeBy: none
