/// Folder or web address that holds the data files (orders, configuration and snapshot), ending in / or \. Use the raw GitHub folder or a local copy of the data folder.
expression DataRoot = "https://raw.githubusercontent.com/jdColonia/powerbi-permit-tracking/main/data/" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 49fb2578-e7d1-4eee-baaf-691b9eeff724
	queryGroup: '1. Parameters'

	annotation PBI_ResultType = Text

/// Names of the order files (.parquet or .csv), separated by semicolons, from oldest to newest (if an order is in two files, the most advanced row wins; on a tie, the newest file).
expression OrderFiles = "orders_history.parquet;orders_current.csv" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 3175890d-1568-493b-abaa-5db9af1046e1
	queryGroup: '1. Parameters'

	annotation PBI_ResultType = Text

/// Opens a data file as binary, from a web folder (DataRoot starting with http) or from a local folder.
expression fnReadFile =
		(fileName as text) as binary =>
		    if Text.StartsWith(DataRoot, "http") then Web.Contents(DataRoot, [RelativePath = fileName])
		    else File.Contents(DataRoot & fileName)
	lineageTag: 64dcaed9-8afc-5aa6-8333-a64a99fbe9e1
	queryGroup: '2. Functions'

	annotation PBI_ResultType = Function

/// Reads a CSV file of the data folder as a table of text columns (first row promoted to headers).
expression fnReadCsv =
		(fileName as text) as table =>
		    Table.PromoteHeaders(
		        Csv.Document(fnReadFile(fileName), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		        [PromoteAllScalars = true])
	lineageTag: 20f60e26-2d46-5beb-b495-b728eb980338
	queryGroup: '2. Functions'

	annotation PBI_ResultType = Function

/// Date of the data snapshot (data/snapshot.csv). Single source of "today" for the whole model, so ages and states stay stable.
expression SnapshotDate =
		let
		    Source = fnReadCsv("snapshot.csv"),
		    Value = Date.FromText(fnText(Source{0}[snapshot_date]), [Format = "yyyy-MM-dd", Culture = "en-US"])
		in
		    Value
	lineageTag: aefd87f6-6ad4-44c3-a06a-742cb4c76e0d
	queryGroup: '2. Functions'

	annotation PBI_ResultType = Date

/// Text of a cell without extra spaces; empty = null (or the ifEmpty value).
expression fnText =
		(value as any, optional ifEmpty as nullable text) as nullable text =>
		    // t = the value as trimmed text (null counts as empty); if it is empty the ifEmpty value is returned
		    let t = if value = null then "" else Text.Trim(Text.From(value))
		    in if t = "" then ifEmpty else t
	lineageTag: b0c4fb0a-69eb-4edf-84e6-64161a5ce2d5
	queryGroup: '2. Functions'

	annotation PBI_ResultType = Function

/// Number of a cell: 4500000 | $ 4,500,000 | 0.19 | 19 %.
expression fnNumber =
		(value as any) as nullable number =>
		    // null -> null; a number stays as is; text is cleaned and parsed with en-US
		    if value = null then null
		    else if value is number then value
		    else
		        let
		            // No spaces or $ sign (the % is detected and removed separately)
		            t = Text.Remove(Text.Trim(Text.From(value)), {" ", "$"}),
		            isPct = Text.EndsWith(t, "%"),
		            withoutPct = Text.Remove(t, {"%"}),
		            n = try Number.FromText(withoutPct, "en-US") otherwise null
		        in
		            // Unreadable or empty -> null; with % the value is divided by 100 ("19 %" -> 0.19)
		            if withoutPct = "" or n = null then null else if isPct then n / 100 else n
	lineageTag: 30709e80-d0c4-4ed9-8259-92d4eaa1c9ec
	queryGroup: '2. Functions'

	annotation PBI_ResultType = Function

/// Whole number of a cell (ids and codes).
expression fnInteger =
		(value as any) as nullable number =>
		    // null -> null; a number is rounded down; text is cleaned, parsed and rounded down
		    if value = null then null
		    else if value is number then Number.RoundDown(value)
		    else
		        let t = Text.Remove(Text.Trim(Text.From(value)), {" "})
		        in if t = "" then null else try Number.RoundDown(Number.FromText(t, "en-US")) otherwise null
	lineageTag: d3a3ed4c-0eda-45e7-a84f-8f018814a5ae
	queryGroup: '2. Functions'

	annotation PBI_ResultType = Function

/// Date of a cell: a date, a datetime or text (yyyy-MM-dd, dd/MM/yyyy). Unreadable values return null.
expression fnDate =
		(value as any) as nullable date =>
		    // Depending on the cell type: date, datetime, datetimezone or text
		    if value = null then null
		    else if value is date then value
		    else if value is datetime then Date.From(value)
		    else if value is datetimezone then Date.From(DateTimeZone.RemoveZone(value))
		    else
		        let
		            // Text: drop the time (what follows a space or a T) and split by / - . into numbers
		            t = Text.Trim(Text.From(value)),
		            dateOnly = Text.BeforeDelimiter(Text.BeforeDelimiter(t, " "), "T"),
		            parts = List.Select(Text.SplitAny(dateOnly, "/-."), each _ <> ""),
		            n = List.Transform(parts, each try Number.FromText(_, "en-US") otherwise null)
		        in
		            // Empty -> null; three readable parts are required; if the first is greater than 31 it is
		            // year-month-day, otherwise day-month-year (a 2-digit year means 20xx)
		            if t = "" then null
		            else if List.Count(n) <> 3 or List.Contains(n, null) then null
		            else if n{0} > 31 then try #date(n{0}, n{1}, n{2}) otherwise null
		            else try #date(if n{2} < 100 then 2000 + n{2} else n{2}, n{1}, n{0}) otherwise null
	lineageTag: 97ced0b8-6324-420b-955f-e820ded1b7c6
	queryGroup: '2. Functions'

	annotation PBI_ResultType = Function

/// Datetime of a cell (a date without time = 00:00).
expression fnDateTime =
		(value as any) as nullable datetime =>
		    // Each cell type is converted directly; a date without time becomes 00:00
		    if value = null then null
		    else if value is datetime then value
		    else if value is datetimezone then DateTimeZone.RemoveZone(value)
		    else if value is date then DateTime.From(value)
		    else
		        // Text: it must be readable as a date (fnDate); with a time it is read by position
		        let
		            t = Text.Trim(Text.From(value)),
		            d = fnDate(value),
		            // ISO yyyy-MM-dd HH:mm[:ss] (space or T): read by position, no culture involved
		            iso =
		                if Text.Length(t) >= 16 and Text.At(t, 4) = "-" and Text.At(t, 7) = "-" and (Text.At(t, 10) = " " or Text.At(t, 10) = "T") and Text.At(t, 13) = ":"
		                then try #datetime(
		                        Number.FromText(Text.Middle(t, 0, 4), "en-US"), Number.FromText(Text.Middle(t, 5, 2), "en-US"), Number.FromText(Text.Middle(t, 8, 2), "en-US"),
		                        Number.FromText(Text.Middle(t, 11, 2), "en-US"), Number.FromText(Text.Middle(t, 14, 2), "en-US"),
		                        if Text.Length(t) >= 19 and Text.At(t, 16) = ":" then Number.FromText(Text.Middle(t, 17, 2), "en-US") else 0) otherwise null
		                else null
		        in if t = "" or d = null then null
		           else if iso <> null then iso
		           else DateTime.From(d)
	lineageTag: 74d16882-bb9d-439a-bbc0-56a734c9f878
	queryGroup: '2. Functions'

	annotation PBI_ResultType = Function

/// Removes accents, diaereses and tildes from a text.
expression fnStripAccents =
		(text as text) as text =>
		    List.Accumulate(
		        {{"á","a"},{"é","e"},{"í","i"},{"ó","o"},{"ú","u"},{"ü","u"},{"ñ","n"},
		         {"Á","A"},{"É","E"},{"Í","I"},{"Ó","O"},{"Ú","U"},{"Ü","U"},{"Ñ","N"}},
		        text, (acc, pair) => Text.Replace(acc, pair{0}, pair{1}))
	lineageTag: 6d8f9858-a426-4945-ba11-0f8eb028c8ef
	queryGroup: '2. Functions'

	annotation PBI_ResultType = Function

/// Text prepared for comparison: upper case, without accents and without double spaces.
expression fnKey =
		(text as nullable text) as nullable text =>
		    if text = null then null
		    else
		        let
		            // u = upper case and without accents
		            u = fnStripAccents(Text.Upper(text)),
		            // Line breaks and tabs count as one space
		            spaced = Text.Replace(Text.Replace(Text.Replace(u, "#(cr)", " "), "#(lf)", " "), "#(tab)", " ")
		        in
		            // Split by spaces, drop the empty parts and join with a single space
		            Text.Combine(List.Select(Text.Split(spaced, " "), each _ <> ""), " ")
	lineageTag: 3d19419f-e1ef-4963-afb4-2ac8239a3ba3
	queryGroup: '2. Functions'

	annotation PBI_ResultType = Function

/// Result of a closure reason: by code and, if it does not match, by text (uses ClosureReasonConfig).
expression fnClosureResult =
		(config as table) as function =>
		    let
		        // ---------- Lookup tables (built once, when the config table is received) ----------
		        // By code: no empty or repeated codes (the first one stays), as a record for fast lookup
		        ByCode = Table.Buffer(Table.Distinct(
		            Table.SelectRows(Table.SelectColumns(config, {"ClosureReasonKey", "ResultKey"}), each [ClosureReasonKey] <> null),
		            {"ClosureReasonKey"})),
		        ResultsByCode = Record.FromList(ByCode[ResultKey], ByCode[ClosureReasonKey]),
		        // By text: ReasonLookup is already normalized with fnKey in ClosureReasonConfig
		        ByText = Table.Buffer(Table.SelectColumns(config, {"ReasonLookup", "ResultKey"})),
		        ResultsByText = Record.FromList(ByText[ResultKey], ByText[ReasonLookup])
		    in
		        // ---------- Returned lookup function: first by code and, if not found, by text ----------
		        (code as nullable text, description as nullable text) as nullable text =>
		            let
		                byCode = if code = null then null else Record.FieldOrDefault(ResultsByCode, code, null),
		                byText = if description = null then null else Record.FieldOrDefault(ResultsByText, fnKey(description), null)
		            in
		                if byCode <> null then byCode else byText
	lineageTag: 50e6c8e7-af27-4966-b7f6-0ce6a78ab579
	queryGroup: '2. Functions'

	annotation PBI_ResultType = Function

