		let
		    // Municipality catalog: official name, department and approximate coordinates of the town centre
		    Coordinates = #table(
		        type table [Municipality = text, Department = text, Latitude = number, Longitude = number],
		        {
		            // ---- Valle del Cauca ----
		            {"Alcalá",                 "Valle del Cauca", 4.6747, -75.7822},
