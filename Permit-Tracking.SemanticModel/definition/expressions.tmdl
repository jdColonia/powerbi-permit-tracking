		            {"Timbiquí",               "Cauca", 2.7719, -77.6653},
		            {"Toribío",                "Cauca", 2.9544, -76.2703},
		            {"Totoró",                 "Cauca", 2.5108, -76.4025},
		            {"Villa Rica",             "Cauca", 3.1778, -76.4608},
		            // ---- Risaralda ----
		            {"Pereira",                "Risaralda", 4.8133, -75.6961},
		            {"Dosquebradas",           "Risaralda", 4.8392, -75.6672},
		            {"Santa Rosa de Cabal",    "Risaralda", 4.8681, -75.6214},
		            {"La Virginia",            "Risaralda", 4.8997, -75.8822},
		            {"Marsella",               "Risaralda", 4.9356, -75.7386},
		            {"Santuario",              "Risaralda", 5.0731, -75.9644},
		            {"Apía",                   "Risaralda", 5.1061, -75.9419},
		            {"Belén de Umbría",        "Risaralda", 5.2017, -75.8689},
		            {"Guática",                "Risaralda", 5.3153, -75.7981},
		            {"La Celia",               "Risaralda", 5.0028, -76.0042},
		            {"Mistrató",               "Risaralda", 5.2967, -75.8828},
		            {"Pueblo Rico",            "Risaralda", 5.2211, -76.0300},
		            {"Quinchía",               "Risaralda", 5.3394, -75.7303},
		            // ---- Quindio ----
		            {"Armenia",                "Quindío", 4.5339, -75.6811},
		            {"Buenavista",             "Quindío", 4.3600, -75.7392},
		            {"Calarcá",                "Quindío", 4.5297, -75.6436},
		            {"Circasia",               "Quindío", 4.6189, -75.6356},
		            {"Córdoba",                "Quindío", 4.3925, -75.6878},
		            {"Filandia",               "Quindío", 4.6747, -75.6581},
		            {"Génova",                 "Quindío", 4.2069, -75.7906},
		            {"La Tebaida",             "Quindío", 4.4528, -75.7881},
		            {"Montenegro",             "Quindío", 4.5664, -75.7511},
		            {"Pijao",                  "Quindío", 4.3344, -75.7044},
		            {"Quimbaya",               "Quindío", 4.6239, -75.7628},
		            {"Salento",                "Quindío", 4.6372, -75.5708}
		        }
		    ),
		
		    // Extra keywords: alternative names that do NOT contain the official name (those that do,
		    // like "SANTIAGO DE CALI", are resolved on their own). Do not repeat an official name here.
		    Aliases = #table(
		        type table [Alias = text, OfficialMunicipality = text],
		        {
		            {"DARIEN", "Calima"},
		            {"BELALCAZAR", "Páez"},
		            {"EL BORDO", "Patía"},
		            {"SANTANDER", "Santander de Quilichao"},
		            {"QUILICHAO", "Santander de Quilichao"},
		            {"LOPEZ", "López de Micay"},
		            // Rural district written without its municipality in parentheses
		            {"SAN RAFAEL", "Santander de Quilichao"}
		        }
		    ),
		
		    // Key table: normalized official name (fnKey) + normalized aliases
		    OfficialKeys = Table.AddColumn(Coordinates, "_Key", each fnKey([Municipality]), type text),
		    AliasKeys = Table.Join(
		        Table.AddColumn(Aliases, "_Key", each fnKey([Alias]), type text), {"OfficialMunicipality"},
		        Coordinates, {"Municipality"}
		    ),
		    Keys = Table.Distinct(
		        Table.Combine({
		            OfficialKeys,
		            Table.SelectColumns(AliasKeys, {"_Key", "Municipality", "Department", "Latitude", "Longitude"})
		        }),
		        {"_Key"}
		    ),
		
		    // Keywords sorted from the longest to the shortest (buffered: not recomputed on every call)
		    SortedKeys = List.Buffer(List.Sort(Keys[_Key], each - Text.Length(_))),
		    // Each keyword with its municipality, department and coordinates (buffered)
		    Data = Table.Buffer(Table.SelectColumns(Keys, {"_Key", "Municipality", "Department", "Latitude", "Longitude"})),
		    ByKey = Record.FromList(Table.ToRecords(Table.SelectColumns(Data, {"Municipality", "Department", "Latitude", "Longitude"})), Data[_Key]),
		
		    // Search text: punctuation -> spaces, normalized, with spaces at both ends to match whole words (" CALI ")
		    fnSearchText = (t as text) as text =>
		        " " & fnKey(
		            List.Accumulate({"(", ")", "-", ",", ".", "/"}, t, (acc, c) => Text.Replace(acc, c, " "))
		        ) & " ",
		
		    // Priority part: inside the last "( )", or after the last "-", or the whole text
		    fnPriorityPart = (description as nullable text) as nullable text =>
		        if description = null then null
		        else if Text.Contains(description, "(") and Text.Contains(description, ")")
		            then Text.Trim(Text.BeforeDelimiter(Text.AfterDelimiter(description, "(", {0, RelativePosition.FromEnd}), ")"))
		        else if Text.Contains(description, "-")
		            then Text.Trim(Text.AfterDelimiter(description, "-", {0, RelativePosition.FromEnd}))
		        else Text.Trim(description),
		
		    // First keyword (longest first) that appears as a whole word in the text; null if none
		    fnFindKey = (text as nullable text) as nullable text =>
		        if text = null then null
		        else
		            let t = fnSearchText(text)
		            in List.First(List.Select(SortedKeys, each Text.Contains(t, " " & _ & " ")), null),
		
		    // Look first in the priority part of the text and, if there is no municipality there, in the whole text
		    fnMunicipality = (text as nullable text) as nullable record =>
		        let
		            inPart = fnFindKey(fnPriorityPart(text)),
		            key = if inPart <> null then inPart else fnFindKey(text)
		        in
		            if key = null then null else Record.FieldOrDefault(ByKey, key, null)
		in
		    fnMunicipality
