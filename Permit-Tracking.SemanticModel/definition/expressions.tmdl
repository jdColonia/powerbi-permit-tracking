	annotation PBI_ResultType = Function

/// Single point that opens the order files: one row per file (parameters DataRoot and OrderFiles).
expression OrdersSource =
		let
		    // ---------- Files ----------
		    // File names from the OrderFiles parameter (separated by ";"), without extra spaces or empty items
		    Names = List.Select(List.Transform(Text.Split(OrderFiles, ";"), Text.Trim), each _ <> ""),
		    // Without any file there is no data: stop with a clear message
		    ValidNames =
		        if List.IsEmpty(Names) then error Error.Record(
		            "No order files",
		            "The OrderFiles parameter is empty. Type the names of the order files separated by semicolons.")
		        else Names,
		
		    // ---------- Reading one file ----------
		    fnReadOrderFile = (name as text) as table =>
		        let
		            // .parquet is read as a typed table; anything else is read as CSV (text columns)
		            isParquet = Text.EndsWith(Text.Lower(name), ".parquet"),
		            // Parquet.Document needs the whole file in memory
		            Source = if isParquet then Parquet.Document(Binary.Buffer(fnReadFile(name))) else fnReadCsv(name),
		            // M is lazy: the read is forced inside try to catch a file that does not open
		            Opened = try Table.RowCount(Source),
		            Checked =
		                if Opened[HasError] then error Error.Record(
		                    "Order file not found",
		                    "Could not open '" & name & "' in DataRoot. Check the DataRoot and OrderFiles parameters.")
		                else Source
		        in
		            Checked,
		
		    // ---------- One row per file ----------
		    // File Position 1 = the first file of the list (the oldest)
		    Files = #table(
		        type table [File = text, #"File Position" = Int64.Type],
		        List.Transform(List.Positions(ValidNames), each {ValidNames{_}, _ + 1})),
		    WithData = Table.AddColumn(Files, "Data", each fnReadOrderFile([File]), type table)
		in
		    WithData
	lineageTag: 2f9bb9f4-aac7-47f1-9d83-ce0328bcb5be
	queryGroup: '3. Staging'

	annotation PBI_ResultType = Table

/// Columns the dashboard expects and the column of each order file that matches each one (empty = the file does not have it).
expression ExpectedColumns =
		let
		    Source = OrdersSource,
		
		    // ---------- Columns the dashboard expects ----------
		    // Fixed list: column name and whether it is required (the list does not depend on the data)
		    Expected = #table(
		        type table [ColumnName = text, Required = logical],
		        {
		            {"Request ID", false},
		            {"Order ID", true},
		            {"Order Type", true},
		            {"Order Created At", true},
		            {"Order Assigned At", false},
		            {"Order Closed At", false},
		            {"Closure Reason Code", false},
		            {"Closure Reason", false},
		            {"Order Status Code", false},
		            {"Order Status", false},
		            {"Location Code", false},
		            {"Location Name", false},
		            {"Work Unit Code", false},
		            {"Work Unit Name", false},
		            {"Closed By Name", false}
		        }),
		
		    // ---------- Match with the headers of each file ----------
		    // Resolves the expected columns against the headers of ONE file
		    fnResolve = (file as text, position as number, data as table) as table =>
		        let
		            SourceNames = List.Buffer(Table.ColumnNames(data)),
		            SourceKeys = List.Buffer(List.Transform(SourceNames, fnKey)),
		            // Header of the file that equals an expected name (null if the file does not have it)
		            fnFindColumn = (name as text) as nullable text =>
		                let pos = List.PositionOf(SourceKeys, fnKey(name)) in if pos < 0 then null else SourceNames{pos},
		            // Each expected column gets the column of the file that matches it
		            Resolved = Table.AddColumn(Expected, "SourceColumn", each fnFindColumn([ColumnName]), type nullable text),
		            // Required columns the file does not have
		            Missing = Table.SelectRows(Resolved, each [Required] and [SourceColumn] = null),
		            // If a required column is missing the refresh stops with a message that names the file and the columns
		            Validated =
		                if Table.IsEmpty(Missing) then Resolved
		                else error Error.Record(
		                    "Required columns are missing",
		                    "Required columns are missing in file " & file & ": " & Text.Combine(Missing[ColumnName], "; ")),
		            WithFile = Table.AddColumn(Table.AddColumn(Validated,
		                "File", each file, type text),
		                "File Position", each position, Int64.Type)
		        in
		            Table.SelectColumns(WithFile, {"File", "File Position", "ColumnName", "Required", "SourceColumn"}),
		
		    // One resolution per file, all together; the table stays in memory
		    PerFile = List.Transform(Table.ToRecords(Source), each fnResolve(_[File], _[#"File Position"], _[Data])),
		    Combined = Table.Combine(PerFile),
		    Final = Table.Buffer(Table.TransformColumnTypes(Combined, {
		        {"File", type text}, {"File Position", Int64.Type}, {"ColumnName", type text},
		        {"Required", type logical}, {"SourceColumn", type text}}))
		in
		    Final
	lineageTag: dc8c1508-9347-4d05-a811-f4275b02e7fa
	queryGroup: '3. Staging'

	annotation PBI_ResultType = Table

/// Order base (all files together) with columns by name, types and tolerant dates, plus File Position.
expression OrdersRead =
		let
		    Source = OrdersSource,
		
		    // ---------- 1. Columns by name, file by file ----------
		    Columns = ExpectedColumns,
		    // Names of the expected columns (once, not per file)
		    ColumnNames = List.Distinct(Columns[ColumnName]),
		    // One file: select and rename ITS columns and add the ones it does not have as empty
		    fnReadOne = (file as text, position as number, data as table) as table =>
		        let
		            // Column resolution of this file (ExpectedColumns)
		            Resolution = Table.SelectRows(Columns, each [File] = file),
		            // Columns the file has: selected and renamed to the model name
		            Found = Table.SelectRows(Resolution, each [SourceColumn] <> null),
		            Selected = Table.SelectColumns(data, Found[SourceColumn]),
		            Renamed = Table.RenameColumns(Selected, List.Select(List.Zip({Found[SourceColumn], Found[ColumnName]}), each _{0} <> _{1})),
		            // Columns the file does not have are added empty (null), one by one
		            WithMissing = List.Accumulate(
		                Table.SelectRows(Resolution, each [SourceColumn] = null)[ColumnName],
		                Renamed,
		                (t, c) => Table.AddColumn(t, c, each null)),
		            WithFile = Table.AddColumn(WithMissing, "File Position", each position, Int64.Type)
		        in
		            WithFile,
		    // All files, one below the other
		    Combined = Table.Combine(List.Transform(Table.ToRecords(Source), each fnReadOne(_[File], _[#"File Position"], _[Data]))),
		
		    // ---------- 2 and 3. Tolerant conversions (shared functions fnText, fnInteger, fnDate and fnDateTime) ----------
		    // Creation and closure with time (the KPI baseline cuts at an exact time)
		    WithTimes = Table.AddColumn(Table.AddColumn(Combined,
		        "Order Created DateTime", each fnDateTime([Order Created At]), type nullable datetime),
		        "Order Closed DateTime", each fnDateTime([Order Closed At]), type nullable datetime),
		
		    // The 3 dates of the order (read tolerantly)
		    DateColumns = {"Order Created At", "Order Assigned At", "Order Closed At"},
		
		    // Types: integers, dates (no time) and text
		    IntegerColumns = {"Request ID", "Order ID", "Order Status Code"},
		    TextColumns = List.Difference(ColumnNames, IntegerColumns & DateColumns),
		    Typed = Table.TransformColumns(WithTimes,
		        List.Transform(IntegerColumns, each {_, fnInteger, Int64.Type})
		        & List.Transform(DateColumns, each {_, fnDate, type date})
		        & List.Transform(TextColumns, each {_, (v) => fnText(v), type text})),
		
		    // Final column order
		    Ordered = Table.ReorderColumns(Typed, ColumnNames
		        & {"Order Created DateTime", "Order Closed DateTime", "File Position"})
		in
		    Ordered
	lineageTag: 7ada2b2f-cc9d-45d9-a6a2-9e6388146436
	queryGroup: '3. Staging'

	annotation PBI_ResultType = Table

/// One row per order, no repeats (the most advanced row wins; on a tie, the newest file). Only the work types of the catalog (config_work_types.csv).
expression OrdersUnique =
		let
		    Source = OrdersRead,
		    // Work type codes of the catalog
		    CatalogTypes = List.Buffer(Dim_WorkType[WorkTypeKey]),
		    // 1 and 2: only orders with a number and of a work type of the catalog
		    WithOrder = Table.SelectRows(Source, each [Order ID] <> null and List.Contains(CatalogTypes, [Order Type])),
		    // 3: per order, the most advanced first (higher status and more recent dates; tie: newest file)
		    MostAdvancedFirst = Table.Buffer(Table.Sort(WithOrder, {
		        {"Order ID", Order.Ascending},
		        {"Order Status Code", Order.Descending},
		        {"Order Closed At", Order.Descending},
		        {"Order Assigned At", Order.Descending},
		        {"Order Created At", Order.Descending},
		        {"File Position", Order.Descending}
		    })),
		    // Table.Distinct keeps the first row of each order, that is, the most advanced one.
		    // Buffered: every loaded table walks this query several times (links, dimensions); without the buffer each walk would read and sort the files again
		    Unique = Table.Buffer(Table.Distinct(MostAdvancedFirst, {"Order ID"}))
		in
		    Unique
	lineageTag: c5feb9be-2b0e-4fc9-9bfe-ca2926db5f5f
	queryGroup: '3. Staging'

	annotation PBI_ResultType = Table

/// Orders of the permit work types (group Filing, Review or Standalone), from OrdersUnique: base of the permit rules.
expression OrdersPermits =
		let
		    Source = OrdersUnique,
		    // Codes of the permit work types (group Filing, Review or Standalone)
		    PermitTypes = List.Buffer(Table.SelectRows(Dim_WorkType, each [Is Permit Work Type])[WorkTypeKey]),
		    PermitsOnly = Table.SelectRows(Source, each List.Contains(PermitTypes, [Order Type]))
		in
		    PermitsOnly
	lineageTag: 5db0d755-2811-421e-b075-be5337de5d80
	queryGroup: '3. Staging'

	annotation PBI_ResultType = Table

/// Closure reasons of config_closure_reasons.csv: code, labels in both languages and the result of each reason.
expression ClosureReasonConfig =
		let
		    // ---------- Reading config_closure_reasons.csv ----------
		    Source = fnReadCsv("config_closure_reasons.csv"),
		    Typed = Table.TransformColumns(Source, {
		        {"Closure Reason Code", each fnText(_), type text}, {"Closure Reason", each fnText(_), type text},
		        {"Reason ES", each fnText(_), type text}, {"Reason EN", each fnText(_), type text},
		        {"Result", each fnText(_), type text}, {"Result ES", each fnText(_), type text}, {"Result EN", each fnText(_), type text}}),
		    Renamed = Table.RenameColumns(Typed, {{"Closure Reason Code", "ClosureReasonKey"}, {"Closure Reason", "SourceText"}, {"Result", "ResultKey"}}),
		    // A reason without a result stays visible as "Undefined" (to be completed in the CSV)
		    WithResult = Table.TransformColumns(Renamed, {
		        {"ResultKey", each if _ = null then "Undefined" else _, type text},
		        {"Result ES", each if _ = null then "Por definir" else _, type text},
		        {"Result EN", each if _ = null then "To be defined" else _, type text}}),
		    // ReasonLookup = reason text normalized (fnKey) to match by text; repeated texts are removed
		    WithLookup = Table.AddColumn(Table.SelectRows(WithResult, each [ClosureReasonKey] <> null), "ReasonLookup", each fnKey([SourceText]), type text),
		    Distinct = Table.Distinct(WithLookup, {"ReasonLookup"}),
		    // Small table queried several times by fnClosureResult and other queries: buffered so the file is not read again
		    Final = Table.Buffer(Distinct)
		in
		    Final
	lineageTag: e6ee0523-a06c-4bb8-87f6-eee9c5f6bbd0
	queryGroup: '3. Staging'

	annotation PBI_ResultType = Table

/// Columns Order ID and Km of config_order_km.csv: kilometres of each national road permit order.
expression OrderKm =
		let
		    Source = fnReadCsv("config_order_km.csv"),
		    Columns = Table.SelectColumns(Table.TransformColumnNames(Source, Text.Trim), {"Order ID", "Km"}, MissingField.UseNull),
		    Typed = Table.TransformColumns(Columns, {
		        {"Order ID", fnInteger, Int64.Type},
		        {"Km", fnNumber, type number}
		    }),
		    // Valid rows: with order and with km (0 or more); a repeated order takes the first row
		    Valid = Table.Distinct(Table.SelectRows(Typed, each [Order ID] <> null and [Km] <> null and [Km] >= 0), {"Order ID"})
		in
		    Valid
	lineageTag: b1a94303-58d0-4d79-a13b-325d99b7edf9
	queryGroup: '3. Staging'

	annotation PBI_ResultType = Table

/// List of requests outside the data scope (their first permit order is a review): read by Fact_Orders and Fact_Permits.
expression RequestsOutsideData =
		let
		    // Work type code -> group key (Filing, Review or Standalone)
		    GroupOfType = Record.FromList(Dim_WorkType[Group Key], Dim_WorkType[WorkTypeKey]),
		    // First permit order (OrdersPermits) of each request
		    FirstPermitOrderFirst = Table.Buffer(Table.Sort(
		        Table.AddColumn(Table.SelectRows(Table.SelectColumns(OrdersPermits, {"Request ID", "Order Type", "Order Created DateTime", "Order ID", "File Position"}), each [Request ID] <> null),
		            "_NoDate", each [Order Created DateTime] = null, type logical),
		        {{"_NoDate", Order.Ascending}, {"Order Created DateTime", Order.Ascending}, {"Order ID", Order.Ascending}, {"File Position", Order.Descending}})),
		    FirstOfRequest = Table.Distinct(FirstPermitOrderFirst, {"Request ID"}),
		    // Requests whose first permit order is a review: a filing must exist before it, and it is not in the data
		    OutsideList = Table.SelectRows(FirstOfRequest, each [Order Type] <> null and Record.FieldOrDefault(GroupOfType, [Order Type], null) = "Review")[Request ID],
		    // Buffered list: several queries read it and search it many times
		    Final = List.Buffer(List.Sort(OutsideList))
		in
		    Final
	lineageTag: 01fb9a82-88a3-436a-8213-52696dcd3dbb
	queryGroup: '3. Staging'

	annotation PBI_ResultType = List
